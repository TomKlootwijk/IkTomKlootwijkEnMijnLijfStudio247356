"""Concrete physical/analog bridges; numerical evidence complements printed proofs."""
from pathlib import Path
import json,math
import numpy as np

def radiation_step(E, photons, C, alpha, beta, weights, scatter, dt):
    # Positive exact elementary flows; ordered composition is first order.
    after=photons*np.exp(-alpha*dt)
    E+=float(np.sum(photons-after));photons=after
    newE=E/(1+3*beta*dt*E**3/C**4)**(1/3)
    photons=photons+weights*(E-newE);E=newE
    # Two-stream symmetric scattering, the exact matrix-exponential subflow.
    mean=float(np.mean(photons));difference=photons[0]-photons[1]
    factor=math.exp(-2*scatter*dt)
    photons=np.array([mean+factor*difference/2,mean-factor*difference/2])
    return E,photons

def plume_diagnostic(X,V,rho,theta,ambient=1.,width=.2,ell0=.1):
    weights=V*rho/(1+np.exp(-(theta-ambient)/width))
    center=np.sum(weights[:,None]*X,axis=0)/sum(weights)
    z=X[:,2]-center[2]
    upper=weights/(1+np.exp(-z/ell0))
    cap_center=np.sum(upper[:,None]*X,axis=0)/sum(upper)
    r2=np.sum((X[:,:2]-cap_center[:2])**2,axis=1)
    cap_a=math.sqrt(float(np.dot(upper,r2)/sum(upper))+ell0**2)
    cap_b=math.sqrt(float(np.dot(upper,(X[:,2]-cap_center[2])**2)/sum(upper))+ell0**2)
    stem_l=math.sqrt(float(np.dot(weights,z*z)/sum(weights))+ell0**2)
    return dict(center=center,cap_center=cap_center,a=cap_a,b=cap_b,
                stem_radius=cap_a/3,stem_halfheight=stem_l,mass=sum(weights))

def conductivity(r,k0=.7,epsilon=.3,omega=2.,rstar=1.):
    return k0*np.exp(epsilon*np.sin(omega*np.log(r/rstar)))

def formation(t):
    R0=np.array([3.,4.,5.]);eps=np.array([.1,.08,.06])
    nu=np.array([.7,.5,.4]);omega=np.array([.2,.17,.13])
    phase=np.array([0.,1.,2.]);mu=1.;mass=np.array([1.,2.,1.5])
    R=R0*(1+eps*np.sin(nu*t));Rd=R0*eps*nu*np.cos(nu*t)
    Rdd=-R0*eps*nu**2*np.sin(nu*t);angle=omega*t+phase
    er=np.column_stack((np.cos(angle),np.sin(angle),np.zeros(3)))
    et=np.column_stack((-np.sin(angle),np.cos(angle),np.zeros(3)))
    position=R[:,None]*er
    velocity=Rd[:,None]*er+(R*omega)[:,None]*et
    acceleration=(Rdd-R*omega**2)[:,None]*er+(2*Rd*omega)[:,None]*et
    control=acceleration+mu/R[:,None]**2*er
    energy=np.sum(mass*(np.sum(velocity**2,axis=1)/2-mu/R))
    power=np.sum(mass*np.sum(control*velocity,axis=1))
    return position,velocity,acceleration,control,float(energy),float(power)

def channel(position,target,wavelength=.8,eta=.6,power=2.):
    d=np.linalg.norm(position-target,axis=1)
    if eta==0:
        h=np.zeros(len(d),dtype=complex);w=np.zeros(len(d),dtype=complex)
        w[0]=math.sqrt(power)
        return h,w
    h=eta*np.exp(-2j*np.pi*d/wavelength)/(d*np.sqrt(np.sum(1/d**2)))
    w=math.sqrt(power)*h.conj()/np.linalg.norm(h)
    return h,w

def verify():
    checks=[]
    def add(name,passed,**data):
        checks.append(dict(name=name,passed=bool(passed),**data))
    E=8.;photons=np.array([2.,1.]);total=E+sum(photons)
    minval=math.inf;residual=0.
    for _ in range(300):
        E,photons=radiation_step(E,photons,2.,np.array([.4,.7]),.06,
                                np.array([.3,.7]),.2,.01)
        minval=min(minval,E,*photons)
        residual=max(residual,abs(E+sum(photons)-total))
    add('closed_absorption_emission_scattering',residual<2e-12 and minval>0,
        steps=300,max_energy_residual=residual,minimum_inventory=minval,
        proof='positive elementary maps and telescoping balances; not continuum convergence')
    rng=np.random.default_rng(20261013)
    X=rng.normal(size=(256,3));V=np.full(256,.01)
    rho=1+.2*rng.random(256);theta=1+rng.random(256)
    diag=plume_diagnostic(X,V,rho,theta)
    shift=np.array([3.,-1.,2.]);diag2=plume_diagnostic(X+shift,V,rho,theta)
    equiv=max(np.max(abs(diag2['center']-diag['center']-shift)),
              np.max(abs(diag2['cap_center']-diag['cap_center']-shift)))
    add('physical_to_plume_diagnostic',equiv<1e-12 and min(diag['a'],diag['b'],diag['stem_radius'],diag['stem_halfheight'])>0,
        samples=256,translation_equivariance_residual=float(equiv),
        cap_radius=diag['a'],cap_tube_radius=diag['b'],scope='derived geometric diagnostic of supplied fluid state')
    q=math.exp(math.pi);r=np.geomspace(.7,4.,1000)
    scale=float(np.max(abs(conductivity(q*r)-conductivity(r))))
    add('discrete_scale_conductivity',scale<1e-14,max_residual=scale,
        q=q,scope='conductivity coefficient only; not scale invariance of every solution')
    errors=[]
    for n in [2001,4001,8001]:
        r=np.linspace(1.,2.,n);k=conductivity(r);P=1.4;theta_b=2.
        integrand=1/(r*r*k)
        panel=(integrand[1:]+integrand[:-1])*np.diff(r)/2
        tail=np.concatenate((np.cumsum(panel[::-1])[::-1],[0.]))
        temp=theta_b+P/(4*math.pi)*tail
        entropy_integrand=P**2/(4*math.pi*r*r*k*temp**2)
        value=float(np.trapezoid(entropy_integrand,r))
        boundary=P*(1/theta_b-1/temp[0])
        errors.append(abs(value-boundary))
    add('scale_patterned_stationary_heat_entropy',errors[-1]<1e-9,
        quadrature_errors=errors,refinement_ratios=[errors[i]/errors[i+1] for i in range(2)],
        scope='quadrature example; differential and boundary identities proved in document')
    orbit_res=0.;power_res=0.;beam_res=0.;optimality_margin=math.inf
    for t in np.linspace(0,5,100):
        pos,vel,acc,ctrl,H,P=formation(float(t));mu=1.
        orbit_res=max(orbit_res,float(np.max(abs(acc+mu*pos/np.linalg.norm(pos,axis=1)[:,None]**3-ctrl))))
        hstep=1e-5
        dh=(formation(float(t+hstep))[4]-formation(float(t-hstep))[4])/(2*hstep)
        power_res=max(power_res,abs(dh-P))
        h,w=channel(pos,np.array([.2,.1,.3]));y=np.dot(h,w)
        beam_res=max(beam_res,abs(abs(y)**2-2*.6**2),abs(np.vdot(w,w).real-2))
        for _ in range(10):
            z=rng.normal(size=3)+1j*rng.normal(size=3);z*=math.sqrt(2)/np.linalg.norm(z)
            optimality_margin=min(optimality_margin,abs(y)**2-abs(np.dot(h,z))**2)
    add('reconfigurable_orbital_formation',orbit_res<1e-14 and power_res<1e-9,
        equation_residual=orbit_res,finite_difference_power_residual=power_res,
        time_samples=100,scope='prescribed controlled trajectory with exact analytic acceleration and work identity')
    add('passive_geometry_dependent_matched_beam',beam_res<1e-12 and optimality_margin>-1e-12,
        max_power_identity_residual=float(beam_res),sampled_competitor_margin=float(optimality_margin),
        channel_norm=.6,transmitted_power=2.,received_power=.72,
        general_proof='Cauchy-Schwarz; normalized channel norm eta gives passive received power P eta^2')
    hz,wz=channel(formation(0.)[0],np.array([.2,.1,.3]),eta=0)
    hp,wp=channel(formation(0.)[0],np.array([.2,.1,.3]),power=0)
    add('zero_channel_and_zero_power_definitions',np.all(hz==0) and np.all(np.isfinite(wz))
        and abs(np.vdot(wz,wz).real-2)<1e-14 and np.all(wp==0),
        zero_channel_output=float(abs(np.dot(hz,wz))),zero_power_output=float(abs(np.dot(hp,wp))))
    projector=np.eye(3)-np.ones((3,3))/3
    v=projector[:,0]/np.linalg.norm(projector[:,0]);L=3*projector
    spectral=float(np.max(abs(L@v-3*v)))
    add('canonical_degenerate_graph_eigenmode',spectral<1e-14 and v[0]>0,
        eigenmode=v.tolist(),eigenvalue=3.,residual=spectral,
        proof='first nonzero canonical-basis projection into selected eigenspace fixes degeneracy and sign')
    from fractions import Fraction as Fr
    radius=Fr(2,3);target=Fr(17,10);initial_error=radius-target
    for _ in range(20):radius=Fr(3,4)*radius+Fr(1,4)*target
    add('positive_exact_radius_fitting_contraction',radius>0 and radius-target==Fr(3,4)**20*initial_error,
        exact_error_factor=str(Fr(3,4)**20),iterations=20,
        scope='explicit convex quadratic radius objective; not generic nonconvex fitting convergence')
    result=dict(suite='XD-TAU v1.5 physical domain bridges',all_passed=all(c['passed'] for c in checks),
                checks=checks,check_count=len(checks))
    Path(__file__).with_name('v15_domain_results.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
    print(json.dumps(result,indent=2))
    assert result['all_passed']

if __name__=='__main__':verify()

