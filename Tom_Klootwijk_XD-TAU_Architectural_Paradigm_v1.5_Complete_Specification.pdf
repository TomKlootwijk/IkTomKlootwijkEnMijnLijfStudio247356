"""XD-TAU v1.5 finite event, geometry, coupling and gate-folding reference.

All data are finite and typed. Geometry primitives are rational boxes and axis
half-spaces. Their exact regular-closed semantics is evaluated on a common finite
axis-plane arrangement, not by naive pointwise Boolean operations on boundaries.
Event materialization and physical evolution are pure replays from fixed bases.
Distinct tags carrying the same XOR payload remain distinct operations.

Valid data: finite ASTs with positive box half-extents; binary paths; nonnegative
activation epochs; finite bit arrays of the declared shape; positive masses,
capacities and fixed step h; nonnegative stiffness, damping, conductance and beam
power. Fraction and arbitrary-size integer arithmetic are exact. No clipping,
rollback, rejection, state repair or waiting stage is part of the dynamics.

Same-tag record collisions have an explicit canonical-max resolution rule. Thus
the finite log merge is also deterministic on collisions; ordinary immutable-tag
use is its compatible special case. Assertions below belong only to verification.
"""

from __future__ import annotations

from collections import Counter
from dataclasses import dataclass
from enum import Enum
from fractions import Fraction as F
from itertools import permutations, product
import json
from pathlib import Path
from random import Random


OUT = Path(__file__).with_name("v15_events_coupling_results.json")


class Kind(str, Enum):
    EMPTY = "empty"
    FULL = "full"
    BOX = "box"
    HALFSPACE = "halfspace"
    UNION = "union"
    MEET = "meet"
    DIFFERENCE = "difference"


@dataclass(frozen=True)
class Node:
    kind: Kind
    parameters: tuple = ()
    children: tuple["Node", ...] = ()


EMPTY = Node(Kind.EMPTY)
FULL = Node(Kind.FULL)


def box(center=(0, 0, 0), half_extents=(1, 1, 1)):
    return Node(Kind.BOX, tuple(F(v) for v in (*center, *half_extents)))


def halfspace(axis, cut, sign=1):
    """Interior sign*(x_axis-cut)<0; sign is -1 or +1 in the typed domain."""
    return Node(Kind.HALFSPACE, (axis, F(cut), sign))


def binary(kind, left, right):
    return Node(kind, (), (left, right))


def replace_at(tree, path, replacement):
    if not path:
        return replacement
    if not tree.children:
        return tree
    side = path[0]
    children = list(tree.children)
    children[side] = replace_at(children[side], path[1:], replacement)
    return Node(tree.kind, tree.parameters, tuple(children))


def wrap_at(tree, path, kind, sibling):
    if not path:
        return binary(kind, tree, sibling)
    if not tree.children:
        return tree
    side = path[0]
    children = list(tree.children)
    children[side] = wrap_at(children[side], path[1:], kind, sibling)
    return Node(tree.kind, tree.parameters, tuple(children))


def qdata(value):
    if isinstance(value, F):
        return {"$qhex": [format(value.numerator, "x"), format(value.denominator, "x")]}
    if isinstance(value, Node):
        return {"kind": value.kind.value, "parameters": qdata(value.parameters),
                "children": [qdata(child) for child in value.children]}
    if isinstance(value, dict):
        return {str(k): qdata(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [qdata(v) for v in value]
    return value


def canonical(value):
    return json.dumps(qdata(value), sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def collect_planes(tree):
    planes = [set(), set(), set()]
    if tree.kind == Kind.BOX:
        for axis in range(3):
            center, extent = tree.parameters[axis], tree.parameters[axis + 3]
            planes[axis].update((center - extent, center + extent))
    elif tree.kind == Kind.HALFSPACE:
        axis, cut, _ = tree.parameters
        planes[axis].add(cut)
    for child in tree.children:
        child_planes = collect_planes(child)
        for axis in range(3):
            planes[axis].update(child_planes[axis])
    return planes


def intervals(planes):
    points = [None, *sorted(planes), None]
    return list(zip(points, points[1:]))


def representative(interval):
    lo, hi = interval
    if lo is None and hi is None:
        return F(0)
    if lo is None:
        return hi - 1
    if hi is None:
        return lo + 1
    return (lo + hi) / 2


def open_cell_value(tree, point):
    kind = tree.kind
    if kind == Kind.EMPTY:
        return False
    if kind == Kind.FULL:
        return True
    if kind == Kind.BOX:
        return all(abs(point[i] - tree.parameters[i]) < tree.parameters[i + 3] for i in range(3))
    if kind == Kind.HALFSPACE:
        axis, cut, sign = tree.parameters
        return sign * (point[axis] - cut) < 0
    a, b = (open_cell_value(child, point) for child in tree.children)
    if kind == Kind.UNION:
        return a or b
    if kind == Kind.MEET:
        return a and b
    return a and not b


def compile_region(tree):
    """Selected full-dimensional open arrangement cells; closure is authoritative."""
    planes = collect_planes(tree)
    selected = []
    for cell in product(*(intervals(p) for p in planes)):
        point = tuple(representative(interval) for interval in cell)
        if open_cell_value(tree, point):
            selected.append(cell)
    return tuple(selected)


def region_contains(region, point):
    return any(all((lo is None or lo <= x) and (hi is None or x <= hi)
                   for (lo, hi), x in zip(cell, point)) for cell in region)


def sampled_geometry_response(tree):
    """A declared finite observation, not a volume or exact optical path length."""
    region = compile_region(tree)
    points = [(F(i), F(0), F(0)) for i in range(-2, 7)]
    return F(sum(region_contains(region, point) for point in points), len(points))


@dataclass(frozen=True, order=True)
class Tag:
    replica: str
    sequence: int


@dataclass(frozen=True)
class Toggle:
    bits: tuple[int, ...]


@dataclass(frozen=True)
class Assign:
    field: str
    value: F


@dataclass(frozen=True)
class Replace:
    path: tuple[int, ...]
    replacement: Node


@dataclass(frozen=True)
class Wrap:
    path: tuple[int, ...]
    kind: Kind
    sibling: Node


@dataclass(frozen=True)
class Event:
    tag: Tag
    epoch: int
    logical_time: int
    payload: Toggle | Assign | Replace | Wrap


def event_data(event):
    payload = event.payload
    if isinstance(payload, Toggle):
        body = {"op": "xor", "bits": payload.bits}
    elif isinstance(payload, Assign):
        body = {"op": "assign", "field": payload.field, "value": payload.value}
    elif isinstance(payload, Replace):
        body = {"op": "replace", "path": payload.path, "replacement": payload.replacement}
    else:
        body = {"op": "wrap", "path": payload.path, "kind": payload.kind.value, "sibling": payload.sibling}
    return {"tag": [event.tag.replica, event.tag.sequence], "epoch": event.epoch,
            "logical_time": event.logical_time, "payload": body}


def version(event):
    return event.logical_time, event.tag.replica, event.tag.sequence, canonical(event_data(event))


def merge_logs(*logs):
    """Finite map union with canonical maximum record per tag (a join semilattice)."""
    winners = {}
    for log in logs:
        for event in log:
            previous = winners.get(event.tag)
            if previous is None or version(event) > version(previous):
                winners[event.tag] = event
    return tuple(sorted(winners.values(), key=version))


@dataclass(frozen=True)
class Base:
    program: Node
    bits: tuple[int, ...]
    assignments: tuple[tuple[str, F], ...]


def materialize(base, log, epoch):
    program = base.program
    bits = list(base.bits)
    assignments = dict(base.assignments)
    versions = {}
    for event in merge_logs(log):
        if event.epoch <= epoch:
            payload = event.payload
            if isinstance(payload, Toggle):
                bits = [a ^ b for a, b in zip(bits, payload.bits)]
            elif isinstance(payload, Assign):
                if payload.field not in versions or version(event) > versions[payload.field]:
                    assignments[payload.field] = payload.value
                    versions[payload.field] = version(event)
            elif isinstance(payload, Replace):
                program = replace_at(program, payload.path, payload.replacement)
            else:
                program = wrap_at(program, payload.path, payload.kind, payload.sibling)
    return {"program": program, "bits": tuple(bits), "assignments": assignments}


def parity_map(bits, n):
    """L(A,B)=A+B+A^T+B^T, output upper triangle in lexicographic pair order."""
    n2 = n * n
    return tuple(bits[i * n + j] ^ bits[j * n + i]
                 ^ bits[n2 + i * n + j] ^ bits[n2 + j * n + i]
                 for i in range(n) for j in range(i + 1, n))


def parity_right_inverse(graph_bits, n):
    result = [0] * (2 * n * n)
    index = 0
    for i in range(n):
        for j in range(i + 1, n):
            result[i * n + j] = graph_bits[index]
            index += 1
    return tuple(result)


def kernel_basis(n):
    n2 = n * n
    basis = []
    # N^2 vectors (A=Eij,B=Eij), hence A+B=0.
    for k in range(n2):
        v = [0] * (2 * n2)
        v[k] = v[n2 + k] = 1
        basis.append(tuple(v))
    # N(N+1)/2 symmetric A matrices with B=0.
    for i in range(n):
        for j in range(i, n):
            v = [0] * (2 * n2)
            v[i * n + j] = 1
            v[j * n + i] = 1
            basis.append(tuple(v))
    return basis


def bit_integer(bits):
    return sum(v << i for i, v in enumerate(bits))


def integer_bits(value, count):
    return tuple((value >> i) & 1 for i in range(count))


def gf2_rank(vectors):
    pivots = {}
    for vector in vectors:
        word = bit_integer(vector)
        while word:
            pivot = word.bit_length() - 1
            if pivot not in pivots:
                pivots[pivot] = word
                break
            word ^= pivots[pivot]
    return len(pivots)


@dataclass(frozen=True)
class XorGateOperation:
    name: str
    left: str
    right: str


def parity_dag(n):
    operations = []
    outputs = []
    for i in range(n):
        for j in range(i + 1, n):
            c_ij, c_ji, q_ij = f"c:{i}:{j}", f"c:{j}:{i}", f"q:{i}:{j}"
            operations += [XorGateOperation(c_ij, f"a:{i}:{j}", f"b:{i}:{j}"),
                           XorGateOperation(c_ji, f"a:{j}:{i}", f"b:{j}:{i}"),
                           XorGateOperation(q_ij, c_ij, c_ji)]
            outputs.append(q_ij)
    return tuple(operations), tuple(outputs)


def fold_schedule(operations, gate_count):
    """Deterministic list schedule; inputs read at cycle start, outputs at cycle end."""
    produced = {op.name for op in operations}
    available = {wire for op in operations for wire in (op.left, op.right)} - produced
    pending = {op.name: op for op in operations}
    schedule = []
    cycle = 0
    while pending:
        ready = sorted((op for op in pending.values() if op.left in available and op.right in available),
                       key=lambda op: op.name)
        batch = ready[:gate_count]
        for gate, operation in enumerate(batch):
            schedule.append((cycle, gate, operation))
        available.update(op.name for op in batch)
        for operation in batch:
            del pending[operation.name]
        cycle += 1
    return tuple(schedule)


def evaluate_folded(bits, n, schedule, outputs):
    n2 = n * n
    wires = {f"a:{i}:{j}": bits[i * n + j] for i in range(n) for j in range(n)}
    wires.update({f"b:{i}:{j}": bits[n2 + i * n + j] for i in range(n) for j in range(n)})
    by_cycle = {}
    for cycle, gate, operation in schedule:
        by_cycle.setdefault(cycle, []).append(operation)
    for cycle in sorted(by_cycle):
        new_wires = {operation.name: wires[operation.left] ^ wires[operation.right]
                     for operation in by_cycle[cycle]}
        wires.update(new_wires)
    return tuple(wires[name] for name in outputs)


def base_profile():
    return Base(box(), (0,) * 8, (("stiffness", F(3)), ("force", F(1, 5)),
                                  ("beam_power", F(7, 3)), ("conductance", F(1, 6))))


def initial_physics():
    return {"q": F(2, 3), "p": F(5, 4), "mass": F(2), "stiffness": F(3),
            "heat": [F(4), F(7)], "capacities": [F(2), F(3)], "time": F(0), "tick": 0,
            "ledger": {"parameter_work": F(0), "port_work": F(0), "beam_in": F(0), "beam_out": F(0)}}


def physics_energy(state):
    return (state["stiffness"] * state["q"] ** 2 + state["p"] ** 2 / state["mass"]) / 2 + sum(state["heat"])


def oscillator_midpoint(q, p, mass, stiffness, damping, force, h):
    a, b, d = h / (2 * mass), h * stiffness / 2, 1 + h * damping / (2 * mass)
    rhs_q = q + a * p
    rhs_p = -b * q + (1 - h * damping / (2 * mass)) * p + h * force
    pnew = (rhs_p - b * rhs_q) / (d + a * b)
    qnew = rhs_q + a * pnew
    midpoint_velocity = (p + pnew) / (2 * mass)
    return qnew, pnew, h * damping * midpoint_velocity ** 2, h * force * midpoint_velocity


def heat_pair_BE(energies, capacities, conductance, h):
    c1, c2 = capacities
    mean = sum(energies) / (c1 + c2)
    difference = (energies[0] / c1 - energies[1] / c2) / (1 + h * conductance * (1 / c1 + 1 / c2))
    return [c1 * (mean + c2 * difference / (c1 + c2)),
            c2 * (mean - c1 * difference / (c1 + c2))]


def replay_physics(base, log, ticks, h=F(1, 5)):
    """Fixed-base physical replay; late events change past prefixes deterministically."""
    s = initial_physics()
    initial = physics_energy(s)
    audit = []
    for tick in range(ticks):
        material = materialize(base, log, tick)
        parameters = material["assignments"]
        before = physics_energy(s)
        expected = F(0)

        def record(name):
            audit.append({"tick": tick, "stage": name, "residual": physics_energy(s) - before - expected})

        parameter_work = (parameters["stiffness"] - s["stiffness"]) * s["q"] ** 2 / 2
        s["stiffness"] = parameters["stiffness"]
        s["ledger"]["parameter_work"] += parameter_work
        expected += parameter_work
        record("events_and_parameter_work")
        sampled = sampled_geometry_response(material["program"])
        graph = parity_map(material["bits"], 2)
        kappa = F(1, 4) + sampled / 5
        conductance = parameters["conductance"] + F(sum(graph), 10)
        record("geometry_and_parity_coefficients")
        s["q"], s["p"], heat, work = oscillator_midpoint(
            s["q"], s["p"], s["mass"], s["stiffness"], F(1, 3), parameters["force"], h)
        s["heat"][0] += heat
        s["ledger"]["port_work"] += work
        expected += work
        record("midpoint_and_heat")
        beam_in = h * parameters["beam_power"]
        beam_out = beam_in / (1 + kappa)
        s["heat"][1] += beam_in - beam_out
        s["ledger"]["beam_in"] += beam_in
        s["ledger"]["beam_out"] += beam_out
        expected += beam_in - beam_out
        record("rational_attenuation_BE")
        s["heat"] = heat_pair_BE(s["heat"], s["capacities"], conductance, h)
        record("heat_pair_BE")
        s["program"] = material["program"]
        s["bits"] = material["bits"]
        s["graph"] = graph
        s["observation"] = sampled
        record("derived_outputs")
        s["time"] += h
        s["tick"] += 1
        record("clock")
    ledger = s["ledger"]
    residual = physics_energy(s) - initial - ledger["parameter_work"] - ledger["port_work"] - ledger["beam_in"] + ledger["beam_out"]
    return s, audit, residual


def example_log():
    pulse = (0, 1, 0, 0, 0, 0, 0, 0)
    return (
        Event(Tag("a", 1), 0, 1, Replace((), box((2, 0, 0)))),
        Event(Tag("b", 1), 0, 2, Wrap((), Kind.UNION, box((5, 0, 0)))),
        Event(Tag("a", 2), 0, 3, Toggle(pulse)),
        Event(Tag("b", 2), 0, 4, Toggle(pulse)),
        Event(Tag("a", 3), 1, 5, Assign("stiffness", F(5))),
        Event(Tag("b", 3), 2, 6, Assign("force", F(-1, 7))),
        Event(Tag("a", 4), 3, 7, Wrap((1,), Kind.DIFFERENCE, box((5, 0, 0), (F(1, 2), 1, 1)))),
        Event(Tag("b", 4), 4, 8, Toggle(pulse)),
    )


def run_verification():
    checks = []

    def check(name, condition, **evidence):
        checks.append({"name": name, "passed": bool(condition), **evidence})
        assert condition, name

    a, b = box(), box((2, 0, 0))
    tree = binary(Kind.UNION, a, b)
    replaced = replace_at(tree, (1,), EMPTY)
    check("typed_AST_replace_and_wrap", replaced == binary(Kind.UNION, a, EMPTY)
          and wrap_at(a, (), Kind.MEET, b) == binary(Kind.MEET, a, b))
    check("missing_path_is_identity", replace_at(a, (0, 1), FULL) == a
          and wrap_at(tree, (1, 0), Kind.UNION, FULL) == tree)

    # A shared plane is a feature, not the regularized meet of opposing half-spaces.
    low, high = halfspace(0, 0, 1), halfspace(0, 0, -1)
    meet = compile_region(binary(Kind.MEET, low, high))
    union = compile_region(binary(Kind.UNION, low, high))
    check("exact_arrangement_regularized_contacts", len(meet) == 0
          and all(region_contains(union, (F(x), F(0), F(0))) for x in (-2, 0, 2)),
          regularized_contact_cells=len(meet), boundary_point_in_union=region_contains(union, (F(0),) * 3))
    self_difference = compile_region(binary(Kind.DIFFERENCE, a, a))
    check("AST_self_difference_and_boundary_occupancy", not self_difference
          and region_contains(compile_region(a), (F(1), F(0), F(0))),
          self_difference_cells=len(self_difference))

    base, logs = base_profile(), example_log()
    pulse = logs[2].payload.bits
    once = materialize(base, (logs[2], logs[2]), 0)
    twice = materialize(base, (logs[2], logs[3]), 0)
    check("distinct_tags_same_XOR_payload_cancel", once["bits"] == pulse and twice["bits"] == base.bits,
          once=list(once["bits"]), twice=list(twice["bits"]), distinct_operations=2)

    lww1 = Event(Tag("c", 1), 0, 2, Assign("stiffness", F(7)))
    lww2 = Event(Tag("d", 1), 0, 3, Assign("stiffness", F(11)))
    lww_results = [materialize(base, order, 0)["assignments"]["stiffness"] for order in permutations((lww1, lww2))]
    check("LWW_total_version_assignment", all(v == 11 for v in lww_results), winning_value="11")

    merge_sets = [(logs[0], logs[2]), (logs[1], logs[3]), (logs[0], logs[4])]
    expected_merge = merge_logs(*merge_sets)
    all_merges = [merge_logs(*order) for order in permutations(merge_sets)]
    assoc = merge_logs(merge_logs(merge_sets[0], merge_sets[1]), merge_sets[2]) == merge_logs(merge_sets[0], merge_logs(merge_sets[1], merge_sets[2]))
    check("finite_log_join_semilattice", all(m == expected_merge for m in all_merges) and assoc
          and merge_logs(expected_merge, expected_merge) == expected_merge,
          delivery_orders=len(all_merges), distinct_tags=len(expected_merge))

    # Explicit optional collision semantics, with no rejected event or delivery-order dependence.
    collision1 = Event(Tag("same", 9), 0, 10, Assign("stiffness", F(2)))
    collision2 = Event(Tag("same", 9), 0, 11, Assign("stiffness", F(13)))
    check("canonical_same_tag_collision_resolution", merge_logs((collision1,), (collision2,))
          == merge_logs((collision2,), (collision1,)) == (collision2,),
          rule="maximum full version/canonical record per tag")

    correct = materialize(base, (logs[0], logs[1]), 0)["program"]
    delivered_late = replace_at(materialize(base, (logs[1],), 0)["program"], (), logs[0].payload.replacement)
    replayed = materialize(base, merge_logs((logs[1],), (logs[0],)), 0)["program"]
    check("late_noncommuting_edit_requires_pure_replay", correct == replayed and correct != delivered_late,
          incremental_arrival_order_is_wrong=True,
          fixed_base_replay_equal=True)
    points = [(F(2), F(0), F(0)), (F(5), F(0), F(0))]
    check("replayed_program_exact_geometry", all(region_contains(compile_region(replayed), p) for p in points))

    # Complete exact physical replay, including parameter work and source/heat ledgers.
    physics, audit, residual = replay_physics(base, logs, 6)
    expected_order = ["events_and_parameter_work", "geometry_and_parity_coefficients", "midpoint_and_heat",
                      "rational_attenuation_BE", "heat_pair_BE", "derived_outputs", "clock"]
    check("exact_rational_composition_energy_ledger", residual == 0 and all(row["residual"] == 0 for row in audit),
          final_residual=str(residual), audited_stages=len(audit), ticks=6)
    check("causal_stage_order_and_positive_heat", all([row["stage"] for row in audit[i:i + 7]] == expected_order
          for i in range(0, len(audit), 7)) and min(physics["heat"]) > 0,
          order=expected_order, final_heat=[float(v) for v in physics["heat"]])
    check("activated_parity_and_geometry_couplings", physics["graph"] == (1,)
          and physics["observation"] == F(5, 9),
          final_graph=list(physics["graph"]), final_geometry_response=str(physics["observation"]),
          activated_graph_epoch=4, geometry_rewrite_epoch=3)
    replay_results = []
    for order in permutations(logs[:4]):
        merged = ()
        for event in (*order, *logs[4:]):
            merged = merge_logs(merged, (event,))
        result, _, r = replay_physics(base, merged, 6)
        replay_results.append(canonical(result) == canonical(physics) and r == 0)
    check("late_log_full_physical_replay_converges", all(replay_results), delivery_orders=len(replay_results),
          fixed_initial_state=True, activated_by_integer_epoch=True)
    # Fixed h gives a direct non-Zeno bound, without a runtime filter.
    h, horizon = F(1, 5), F(1)
    bound = int(horizon / h) + 1
    active_ticks = sum(F(tick) * h <= horizon for tick in range(100))
    check("non_Zeno_fixed_clock_bound", active_ticks == bound and physics["time"] == F(6, 5),
          h=str(h), horizon=str(horizon), ticks_up_to_horizon=active_ticks,
          assumption="each integer epoch has finitely many events; h is fixed positive")

    parity_records = []
    for n in (1, 2, 3):
        dimension, m = 2 * n * n, n * (n - 1) // 2
        fiber_counts = Counter()
        outputs = []
        for word in range(1 << dimension):
            result = bit_integer(parity_map(integer_bits(word, dimension), n))
            fiber_counts[result] += 1
            outputs.append(result)
        basis = kernel_basis(n)
        kernel_dim = dimension - m
        inverse_ok = all(parity_map(parity_right_inverse(integer_bits(q, m), n), n) == integer_bits(q, m)
                         for q in range(1 << m))
        basis_ok = len(basis) == gf2_rank(basis) == kernel_dim and all(not any(parity_map(v, n)) for v in basis)
        fibers_ok = len(fiber_counts) == 1 << m and set(fiber_counts.values()) == {1 << kernel_dim}
        check(f"parity_surjection_kernel_exhaustive_N{n}", inverse_ok and basis_ok and fibers_ok,
              N=n, domain_dimension=dimension, graph_dimension=m, kernel_dimension=kernel_dim,
              domain_points=1 << dimension, image_points=len(fiber_counts), fiber_size=1 << kernel_dim,
              kernel_basis_rank=gf2_rank(basis))
        if n == 2:
            linear_ok = all(outputs[x ^ y] == (outputs[x] ^ outputs[y])
                            for x in range(1 << dimension) for y in range(1 << dimension))
            check("parity_linearity_all_N2_input_pairs", linear_ok, input_pairs=(1 << dimension) ** 2)
        parity_records.append({"N": n, "domain_points": 1 << dimension, "image_points": 1 << m,
                               "kernel_dimension": kernel_dim})

    n = 4
    operations, outputs = parity_dag(n)
    m = n * (n - 1) // 2
    rng = Random(20261013)
    inputs = [integer_bits(rng.getrandbits(2 * n * n), 2 * n * n) for _ in range(256)]
    schedule_records = []
    for gates in (1, 2, 3, 2 * m):
        scheduled = fold_schedule(operations, gates)
        output_cycle = {op.name: cycle for cycle, gate, op in scheduled}
        resource_ok = len({(cycle, gate) for cycle, gate, op in scheduled}) == len(scheduled)
        precedence_ok = all(all(wire not in output_cycle or output_cycle[wire] < cycle
                                for wire in (op.left, op.right)) for cycle, gate, op in scheduled)
        values_ok = all(evaluate_folded(bits, n, scheduled, outputs) == parity_map(bits, n) for bits in inputs)
        cycles = max((cycle for cycle, gate, op in scheduled), default=-1) + 1
        check(f"folded_parity_gates_{gates}", resource_ok and precedence_ok and values_ok
              and len(scheduled) == 3 * m and all(gate < gates for cycle, gate, op in scheduled),
              reusable_gates=gates, operations=len(scheduled), cycles=cycles, samples=len(inputs))
        schedule_records.append({"gates": gates, "cycles": cycles, "operations": len(scheduled)})
    check("folding_latency_endpoints", schedule_records[0]["cycles"] == 3 * m
          and schedule_records[-1]["cycles"] == 2,
          one_gate_cycles=3 * m, abundant_gate_cycles=2,
          timing_model="one synchronous XOR per gate per cycle; retained virtual wire values; no measured wire delay")

    return {"edition": "XD-TAU v1.5 events, coupling and temporal gate folding",
            "summary": {"all_passed": all(item["passed"] for item in checks), "checks": len(checks),
                        "exact_rational_ledger_residual": str(residual), "physical_ticks": 6,
                        "physical_stage_audits": len(audit)},
            "checks": checks, "parity_exhaustive": parity_records, "folded_schedules": schedule_records,
            "proofs": {
                "parity_right_inverse": "Put Q_ij into A_ij for i<j and zero elsewhere; B=0. Then A+B+A^T+B^T=Q.",
                "parity_kernel": "The map has domain dimension 2N^2 and image dimension N(N-1)/2, so kernel dimension (3N^2+N)/2. A basis consists of (Eij,Eij) and (Sij,0), with Sij the symmetric diagonal/off-diagonal basis.",
                "C_only_kernel": "For C=A+B, C->C+C^T has the symmetric-matrix kernel of dimension N(N+1)/2; its image is all symmetric zero-diagonal matrices.",
                "log_join": "Finite per-tag canonical maximum is associative, commutative and idempotent. Pure materialization is a deterministic function of that map and its fixed base.",
                "folding": "Each gate operation has the same operands as the parity DAG. Precedence supplies their values before execution; induction over cycles preserves every DAG value despite gate reuse.",
                "non_Zeno": "With fixed h>0 and finitely many events per integer epoch, a finite physical interval contains finitely many epochs and events. No runtime filter is used.",
            },
            "scope": [
                "The AST primitives are rational boxes and axis half-spaces; finite arrangement evaluation implements their exact regular-closed Boolean semantics.",
                "The sampled geometry response is an explicit finite observation, not exact optical path length, volume, distance or arbitrary black-box geometry.",
                "Rational attenuation and heat exchange are backward-Euler consistency maps, not exact exponential flows.",
                "The exact physical source ledger includes event-induced stiffness work, port work and incoming/outgoing beam energy.",
                "Physical replica convergence here is fixed-base replay of the same activated event history, not incremental arrival-order evolution.",
                "The gate schedule proves logical functional equivalence and its declared synchronous latency, not measured RC behavior or a hardware speedup.",
                "The general local/global composition and continuation assumptions are stated in v15_composition_audit.md.",
            ]}


if __name__ == "__main__":
    results = run_verification()
    OUT.write_text(json.dumps(results, indent=2, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(results["summary"], indent=2))
    print(f"Results: {OUT}")

endstream
