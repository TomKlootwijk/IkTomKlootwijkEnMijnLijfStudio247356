"""Finite regression evidence for XD-TAU v1.4 CSG semantics.

The general regular-closed Boolean-algebra and signed-distance results are
analytical theorems, not conclusions established by this finite suite.  This
suite independently implements one exact geometric subalgebra: finite unions
of closed slabs in R^3, including unbounded slabs, the empty set and all space.
All interval endpoints and set operations are exact; floating-point checks
are confined to distance fields, smooth scalar operators and derivative
examples.  No PDF is generated or edited here.
"""

from __future__ import annotations

from dataclasses import dataclass
from fractions import Fraction
from itertools import product
from pathlib import Path
import json
import math
import random


BASE = Path(__file__).resolve().parent
RESULT = BASE / "v14_csg_results.json"
CHECKS = []
NEG_INF, POS_INF = -math.inf, math.inf


def check(name, condition, **evidence):
    CHECKS.append({"name": name, "passed": bool(condition), **evidence})
    if not condition:
        raise AssertionError(name)


@dataclass(frozen=True)
class Slabs:
    """Regular-closed slabs with transverse factor R^2.

    Intervals are closed, sorted and separated by positive-width gaps.
    A zero-width interval is a plane and is removed by regularization.
    """

    intervals: tuple

    @staticmethod
    def from_intervals(intervals):
        merged = []
        for lo, hi in sorted((lo, hi) for lo, hi in intervals if lo < hi):
            if merged and lo <= merged[-1][1]:
                merged[-1] = (merged[-1][0], max(merged[-1][1], hi))
            else:
                merged.append((lo, hi))
        return Slabs(tuple(merged))

    def join(self, other):
        return Slabs.from_intervals(self.intervals + other.intervals)

    def meet(self, other):
        # Raw intersections with equal endpoints are retained in the generator
        # and removed by from_intervals, implementing cl(int(A intersect B)).
        return Slabs.from_intervals(
            (max(a, c), min(b, d))
            for a, b in self.intervals for c, d in other.intervals
            if max(a, c) <= min(b, d)
        )

    def complement(self):
        if not self.intervals:
            return FULL
        gaps, cursor = [], NEG_INF
        for lo, hi in self.intervals:
            if cursor < lo:
                gaps.append((cursor, lo))
            cursor = hi
        if cursor < POS_INF:
            gaps.append((cursor, POS_INF))
        return Slabs.from_intervals(gaps)

    def difference(self, other):
        return self.meet(other.complement())

    def contains(self, x):
        return any(lo <= x <= hi for lo, hi in self.intervals)

    def interior_contains(self, x):
        return any(lo < x < hi for lo, hi in self.intervals)

    def distance_to(self, x):
        if not self.intervals:
            return POS_INF
        return min(0.0 if lo <= x <= hi else
                   lo - x if x < lo else x - hi
                   for lo, hi in self.intervals)

    def signed_distance(self, x):
        if self == EMPTY:
            return POS_INF
        if self == FULL:
            return NEG_INF
        if self.contains(x):
            for lo, hi in self.intervals:
                if lo <= x <= hi:
                    return -min(x - lo, hi - x)
        return self.distance_to(x)

    def canonical(self, x, ell=2.0):
        if self == EMPTY:
            return ell
        if self == FULL:
            return -ell
        distance = self.signed_distance(x)
        return ell * distance / (ell + abs(distance))


EMPTY = Slabs(())
FULL = Slabs(((NEG_INF, POS_INF),))
BOUNDARIES = (-1, 0, 1)
CELL_ENDPOINTS = (NEG_INF,) + BOUNDARIES + (POS_INF,)
CELL_COUNT = len(CELL_ENDPOINTS) - 1
CELL_SAMPLES = (-2.0, -0.5, 0.5, 2.0)
ALL_BITS = (1 << CELL_COUNT) - 1


def from_bits(bits):
    return Slabs.from_intervals(
        (CELL_ENDPOINTS[j], CELL_ENDPOINTS[j + 1])
        for j in range(CELL_COUNT) if bits & (1 << j)
    )


REGIONS = tuple(from_bits(bits) for bits in range(ALL_BITS + 1))


def arrangement_checks():
    pair_laws = triple_laws = 0
    for bits, a in enumerate(REGIONS):
        assert a.join(EMPTY) == a
        assert a.meet(FULL) == a
        assert a.join(FULL) == FULL
        assert a.meet(EMPTY) == EMPTY
        assert a.join(a) == a and a.meet(a) == a
        assert a.complement().complement() == a
        assert a.join(a.complement()) == FULL
        assert a.meet(a.complement()) == EMPTY
        assert a.difference(a) == EMPTY
        assert a.complement() == from_bits(ALL_BITS ^ bits)
        for other_bits, b in enumerate(REGIONS):
            assert a.join(b) == from_bits(bits | other_bits)
            assert a.meet(b) == from_bits(bits & other_bits)
            assert a.difference(b) == from_bits(bits & (ALL_BITS ^ other_bits))
            assert a.join(b) == b.join(a)
            assert a.meet(b) == b.meet(a)
            assert a.join(a.meet(b)) == a
            assert a.meet(a.join(b)) == a
            assert a.join(b).complement() == a.complement().meet(b.complement())
            assert a.meet(b).complement() == a.complement().join(b.complement())
            pair_laws += 9
            for c in REGIONS:
                assert a.join(b).join(c) == a.join(b.join(c))
                assert a.meet(b).meet(c) == a.meet(b.meet(c))
                assert a.meet(b.join(c)) == a.meet(b).join(a.meet(c))
                assert a.join(b.meet(c)) == a.join(b).meet(a.join(c))
                triple_laws += 4
    check("exhaustive_regular_closed_slab_boolean_algebra", True,
          evidence_kind="exact finite geometric regression, not general theorem proof",
          ambient_space="R^3; slab coordinate x_1; transverse factor R^2",
          full_dimensional_cells=CELL_COUNT, regions=len(REGIONS),
          ordered_pairs=len(REGIONS) ** 2, ordered_triples=len(REGIONS) ** 3,
          pair_law_assertions=pair_laws, triple_law_assertions=triple_laws,
          laws=["identity", "annihilation", "idempotence", "complement",
                "commutativity", "associativity", "absorption",
                "distributivity", "De Morgan", "self difference"],
          independently_checked_against_cell_label_bit_operations=True)


def counterexample_checks():
    left = Slabs.from_intervals(((NEG_INF, 0),))
    right = Slabs.from_intervals(((0, POS_INF),))
    assert left.contains(0) and right.contains(0)
    assert left.meet(right) == EMPTY
    assert left.join(right) == FULL
    check("boundary_only_contact_and_regularization", True,
          raw_intersection="{x_1 = 0}", regularized_intersection="empty",
          regularized_union="R^3", boundary_retained_as_separate_feature=True)

    raw_difference_value = max(-1.0, -0.0)
    corrected = FULL.difference(EMPTY)
    check("zero_field_raw_subtraction_counterexample_and_region_first_repair",
          raw_difference_value == 0 and corrected == FULL and
          max(FULL.canonical(0), -EMPTY.canonical(0)) < 0,
          imports={"a=-1": "R^3", "b=0": "empty"},
          flawed_raw_field="max(-1,-0)=0; negative set empty",
          required_and_corrected_region="R^3",
          canonical_output_at_origin=corrected.canonical(0))

    # b(x)=max(x,0) has no negative points.  The raw difference is negative
    # exactly for x>0, although full minus imported b should remain full.
    raw_support = Slabs.from_intervals(((0, POS_INF),))
    for x in (-2.0, -0.5, 0.0, 0.5, 2.0):
        assert (max(-1.0, -max(x, 0.0)) < 0) == (x > 0)
    check("positive_halfspace_zero_plateau_counterexample", raw_support != FULL,
          imported_b="empty", raw_subtraction_region="{x_1 >= 0}",
          corrected_region="R^3")

    # These imports are established analytically from their exact negative
    # sets.  A finite sample is not used to infer a set's interior or closure.
    fixtures = [
        {"field": "0", "negative_set": "empty", "import": "empty"},
        {"field": "x_1^2", "negative_set": "empty", "import": "empty",
         "zero_feature": "{x_1=0}"},
        {"field": "-x_1^2", "negative_set": "R^3 \\ {x_1=0}", "import": "R^3"},
        {"field": "-1 on {x_1=0}, +1 elsewhere",
         "negative_set": "{x_1=0}", "negative_set_interior": "empty", "import": "empty"},
    ]
    check("analytic_degenerate_import_fixtures", True,
          evidence_kind="exact symbolic fixtures with stated negative sets",
          cases=fixtures)

    # A Boolean node's raw min/max field need not itself be canonical.
    check("canonical_regeneration_at_buried_seam",
          min(left.canonical(0), right.canonical(0)) == 0 and
          left.join(right).canonical(0) < 0,
          raw_union_field_at_shared_plane=0,
          canonical_full_region_field_at_shared_plane=FULL.canonical(0))


def distance_checks():
    xs = [k / 8 for k in range(-32, 33)]
    max_distance_lipschitz_excess = 0.0
    max_canonical_lipschitz_excess = 0.0
    count = 0
    for region in REGIONS:
        for x in xs:
            d = region.signed_distance(x)
            phi = region.canonical(x)
            assert math.isfinite(phi)
            assert (phi < 0) == region.interior_contains(x)
            assert (phi <= 0) == region.contains(x)
            assert (phi > 0) == (not region.contains(x))
            assert (d < 0) == region.interior_contains(x)
            assert (d <= 0) == region.contains(x)
            if region not in (EMPTY, FULL):
                expected = region.distance_to(x) - region.complement().distance_to(x)
                assert d == expected
            for y in xs:
                separation = abs(x - y)
                if region not in (EMPTY, FULL):
                    excess = abs(d - region.signed_distance(y)) - separation
                    max_distance_lipschitz_excess = max(max_distance_lipschitz_excess, excess)
                excess = abs(phi - region.canonical(y)) - separation
                max_canonical_lipschitz_excess = max(max_canonical_lipschitz_excess, excess)
            count += 1
    check("signed_distance_and_finite_canonical_cases",
          max_distance_lipschitz_excess <= 1e-14 and
          max_canonical_lipschitz_excess <= 1e-14,
          regions=len(REGIONS), points_per_region=len(xs), evaluations=count,
          pairwise_lipschitz_comparisons=len(REGIONS) * len(xs) ** 2,
          empty_distance="+infinity", full_distance="-infinity",
          empty_finite_field=2.0, full_finite_field=-2.0,
          maximum_distance_lipschitz_excess=max_distance_lipschitz_excess,
          maximum_canonical_lipschitz_excess=max_canonical_lipschitz_excess)

    for a, b in product(REGIONS, repeat=2):
        actual = [a.join(b), a.meet(b), a.difference(b), a.complement()]
        reconstructed_bits = [0, 0, 0, 0]
        for j, x in enumerate(CELL_SAMPLES):
            av, bv = a.canonical(x), b.canonical(x)
            values = [min(av, bv), max(av, bv), max(av, -bv), -av]
            for k, value in enumerate(values):
                if value < 0:
                    reconstructed_bits[k] |= 1 << j
        assert [from_bits(bits) for bits in reconstructed_bits] == actual
    check("canonical_field_hard_node_recovery", True,
          ordered_region_pairs=len(REGIONS) ** 2,
          full_dimensional_cell_probes=CELL_COUNT,
          reconstructed_operations=["union", "intersection", "difference", "complement"],
          note="Cell probes exactly identify this fixed finite cell subalgebra; arbitrary sampled fields are not inferred.")


def smin(a, b, h):
    if math.isinf(a) or math.isinf(b):
        return min(a, b)
    delta = abs(a - b)
    bias = h * h / (math.hypot(delta, math.sqrt(2) * h) + delta)
    return min(a, b) - bias


def smax(a, b, h):
    if math.isinf(a) or math.isinf(b):
        return max(a, b)
    delta = abs(a - b)
    bias = h * h / (math.hypot(delta, math.sqrt(2) * h) + delta)
    return max(a, b) + bias


def smooth_checks():
    rng = random.Random(20261013)
    maximum_duality_error = maximum_formula_relative_error = 0.0
    maximum_bias_ratio = 0.0
    for _ in range(20000):
        a, b = rng.uniform(-100, 100), rng.uniform(-100, 100)
        h = 10 ** rng.uniform(-4, 2)
        delta = abs(a - b)
        bias = h * h / (math.hypot(delta, math.sqrt(2) * h) + delta)
        assert bias > 0
        assert bias <= h / math.sqrt(2) * (1 + 1e-14)
        maximum_bias_ratio = max(maximum_bias_ratio, bias / (h / math.sqrt(2)))
        actual = smin(a, b, h)
        direct = (a + b - math.sqrt((a - b) ** 2 + 2 * h * h)) / 2
        maximum_formula_relative_error = max(maximum_formula_relative_error,
                                             abs(actual - direct) / (1 + abs(actual)))
        maximum_duality_error = max(maximum_duality_error,
                                    abs(smax(a, b, h) + smin(-a, -b, h)))
    equality_error = abs(smin(0, 0, 3) + 3 / math.sqrt(2))
    check("smooth_bias_duality_and_formula", maximum_duality_error == 0 and
          maximum_formula_relative_error < 1e-13 and equality_error < 1e-14,
          random_samples=20000, seed=20261013,
          maximum_duality_error=maximum_duality_error,
          maximum_formula_relative_error=maximum_formula_relative_error,
          maximum_sampled_bias_bound_ratio=maximum_bias_ratio,
          equal_input_bias_bound_residual=equality_error,
          analytical_bias="h^2/(sqrt((a-b)^2+2h^2)+|a-b|)",
          evidence_kind="floating-point regression; analytic inequality supplied separately")

    tagged = [NEG_INF, -1.0, 0.0, 1.0, POS_INF]
    for a, b in product(tagged, repeat=2):
        if math.isinf(a) or math.isinf(b):
            assert smin(a, b, 0.5) == min(a, b)
            assert smax(a, b, 0.5) == max(a, b)
        assert smax(a, b, 0.5) == -smin(-a, -b, 0.5)
    for a in tagged:
        assert smin(a, POS_INF, 0.5) == a
        assert smax(a, NEG_INF, 0.5) == a
        assert smin(a, NEG_INF, 0.5) == NEG_INF
        assert smax(a, POS_INF, 0.5) == POS_INF
    check("smooth_extended_distance_tagged_identities", True,
          tagged_pairs=len(tagged) ** 2,
          never_evaluates_infinity_minus_infinity=True,
          identities=["union with empty", "intersection with full",
                      "union with full", "intersection with empty", "duality"])

    ell, h = 1.0, 2.0
    check("finite_saturated_constants_are_not_distance_blend_inputs",
          smin(ell, ell, h) < 0 and smin(POS_INF, POS_INF, h) == POS_INF,
          finite_empty_constant_blend=smin(ell, ell, h),
          corrected_empty_distance_blend="+infinity",
          conclusion="Use extended exact distances, with tagged limits, for smooth region semantics.")

    # Smooth union of opposite half-spaces has all-space occupancy for h>0;
    # two exterior half-spaces (-inf,-1] and [1,inf) leave a finite gap.
    a = Slabs.from_intervals(((NEG_INF, -1),))
    b = Slabs.from_intervals(((1, POS_INF),))
    h = 0.4
    offset = h / math.sqrt(2)
    checked_points = 0
    for k in range(-4000, 4001):
        x = k / 1000
        value = smin(a.signed_distance(x), b.signed_distance(x), h)
        if a.interior_contains(x) or b.interior_contains(x):
            assert value < 0
        if value < 0 and not a.join(b).contains(x):
            assert a.join(b).distance_to(x) <= offset + 1e-14
        checked_points += 1
    check("smooth_union_spatial_offset_example", True,
          points=checked_points, h=h, spatial_offset_bound=offset,
          evidence_kind="finite example supporting separately stated general inclusion proof")


def polynomial_product(a, b):
    out = [Fraction(0)] * (len(a) + len(b) - 1)
    for i, av in enumerate(a):
        for j, bv in enumerate(b):
            out[i + j] += av * bv
    return out


def integral(poly, lo, hi):
    return sum(Fraction(coefficient, k + 1) *
               (Fraction(hi) ** (k + 1) - Fraction(lo) ** (k + 1))
               for k, coefficient in enumerate(poly))


def derivative_checks():
    final = lambda x: max(min(x, -x), 0.0)
    probes = [-1.0, -1e-3, -1e-6, 0.0, 1e-6, 1e-3, 1.0]
    assert all(final(x) == 0 for x in probes)
    step = 1e-6
    final_derivative = (final(step) - final(-step)) / (2 * step)
    invalid_nested_tie_derivative = 1.0
    check("nested_branch_derivative_counterexample",
          final_derivative == 0 and invalid_nested_tie_derivative != 0,
          final_function="max(min(x,-x),0) identically zero",
          true_Clarke_gradient=[0, 0],
          arbitrary_nested_tie_AD=invalid_nested_tie_derivative,
          correct_final_function_derivative=final_derivative,
          conclusion="A nested branch derivative may lie outside the final function Clarke gradient.")

    # F(x)=x+x^2 sin(1/x), F(0)=0 is differentiable at zero with derivative
    # 1, but F'(x)=1+2x sin(1/x)-cos(1/x), whose limit set is [0,2].
    # At x=1/(2*pi*k), F'(x)=0; at x=1/((2*k+1)*pi), it equals 2.
    def oscillatory_derivative(x):
        return 1 + 2 * x * math.sin(1 / x) - math.cos(1 / x)
    residual = 0.0
    for k in (10, 100, 1000):
        residual = max(residual,
                       abs(oscillatory_derivative(1 / (2 * math.pi * k))),
                       abs(oscillatory_derivative(1 / ((2 * k + 1) * math.pi)) - 2))
    check("mere_differentiability_does_not_collapse_Clarke_gradient", residual < 1e-12,
          field="F(x)=x+x^2 sin(1/x), F(0)=0",
          ordinary_derivative_at_zero=1,
          Clarke_gradient_at_zero=[0, 2],
          minimum_norm_Clarke_selection=0,
          limiting_sequence_gradient_residual=residual,
          corrected_statement="The Clarke gradient reduces to the ordinary gradient under strict differentiability, in particular when F is C1 locally.")

    # m=sign(x), f=1+x; test psi=(1+x)(1-x^2)^2 on [-1,1], zero outside.
    # psi and psi' vanish at endpoints, so this is a compact C1 test function.
    psi = [1, 1, -2, -2, 1, 1]
    psi_prime = [(k + 1) * psi[k + 1] for k in range(len(psi) - 1)]
    product_poly = polynomial_product([1, 1], psi_prime)
    weak_derivative_pairing = integral(product_poly, -1, 0) - integral(product_poly, 0, 1)
    bulk = -integral(psi, -1, 0) + integral(psi, 0, 1)
    seam = Fraction(2) * psi[0]
    check("discontinuous_mask_weak_derivative_includes_jump",
          weak_derivative_pairing == bulk + seam and seam != 0,
          field="F(x)=sign(x)(1+x)",
          exact_test_function="(1+x)(1-x^2)^2 on [-1,1], zero elsewhere",
          weak_pairing=str(weak_derivative_pairing),
          bulk_pairing=str(bulk), seam_pairing=str(seam),
          derivative="DF=sign(x) dx + 2 delta_0",
          evidence_kind="exact rational integration of one weak-derivative fixture")


def main():
    arrangement_checks()
    counterexample_checks()
    distance_checks()
    smooth_checks()
    derivative_checks()
    report = {
        "suite": "XD-TAU v1.4 CSG independent regression evidence",
        "passed": all(item["passed"] for item in CHECKS),
        "check_count": len(CHECKS),
        "proof_scope": {
            "general_theorems": "Analytical proofs belong in the document; finite checks do not prove the full architecture.",
            "exact_exhaustive_scope": "All 16 regular-closed regions generated by four full-dimensional slab cells; all 4096 ordered triples.",
            "floating_point_scope": "Specified signed-distance samples, scalar smooth operators and derivative witnesses.",
            "no_topology_inference_from_finite_samples": True,
        },
        "prior_construction_correction": {
            "defect": "Clarke gradient need not equal the ordinary gradient at a merely differentiable point.",
            "replacement": "Equality holds under strict differentiability, including C1 regularity in a neighborhood.",
            "witness": "F(x)=x+x^2 sin(1/x), F(0)=0: F'(0)=1, partial^C F(0)=[0,2].",
        },
        "checks": CHECKS,
    }
    RESULT.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps({"passed": report["passed"], "checks": len(CHECKS),
                      "exact_regions": len(REGIONS), "ordered_triples": len(REGIONS) ** 3,
                      "results": str(RESULT)}, indent=2))


if __name__ == "__main__":
    main()

endstream
