"""Exact algebra and numerical examples for the v1.4 physical completion.

No SymPy/SciPy is required. Fraction polynomial algebra proves finite symbolic
identities; generalized Laurent monomials represent the exact homogeneous
Einstein-scalar profile. RK4 examples are expressly numerical evidence, not
proofs of the continuum existence claims. No state clipping is performed.
"""
from __future__ import annotations

from fractions import Fraction as F
from pathlib import Path
import json
import math
import platform
import numpy as np


class Poly:
    """Sparse exact polynomial in named commuting indeterminates."""
    def __init__(self, terms=None):
        self.terms = {k: F(v) for k, v in (terms or {}).items() if v}

    @classmethod
    def var(cls, name):
        return cls({((name, 1),): F(1)})

    @classmethod
    def const(cls, value):
        return cls({(): F(value)})

    def __add__(self, other):
        other = other if isinstance(other, Poly) else Poly.const(other)
        result = self.terms.copy()
        for key, value in other.terms.items():
            result[key] = result.get(key, F(0)) + value
        return Poly(result)

    __radd__ = __add__

    def __neg__(self):
        return Poly({k: -v for k, v in self.terms.items()})

    def __sub__(self, other):
        return self + (-other if isinstance(other, Poly) else -F(other))

    def __rsub__(self, other):
        return -self + other

    def __mul__(self, other):
        other = other if isinstance(other, Poly) else Poly.const(other)
        result = {}
        for k1, v1 in self.terms.items():
            for k2, v2 in other.terms.items():
                powers = dict(k1)
                for name, exponent in k2:
                    powers[name] = powers.get(name, 0) + exponent
                key = tuple(sorted(powers.items()))
                result[key] = result.get(key, F(0)) + v1 * v2
        return Poly(result)

    __rmul__ = __mul__

    def zero_at(self, name):
        return Poly({k: v for k, v in self.terms.items()
                     if all(n != name for n, _ in k)})

    def derivative(self, name):
        result = {}
        for key, coefficient in self.terms.items():
            powers = dict(key)
            exponent = powers.get(name, 0)
            if not exponent:
                continue
            if exponent == 1:
                del powers[name]
            else:
                powers[name] = exponent - 1
            newkey = tuple(sorted(powers.items()))
            result[newkey] = result.get(newkey, F(0)) + coefficient * exponent
        return Poly(result)

    def is_nonnegative_on_orthant(self):
        return all(value >= 0 for value in self.terms.values())

    def text(self):
        if not self.terms:
            return "0"
        terms = []
        for powers, coefficient in sorted(self.terms.items()):
            factors = [name if exponent == 1 else f"{name}^{exponent}"
                       for name, exponent in powers]
            terms.append(str(coefficient) + ("*" + "*".join(factors) if factors else ""))
        return " + ".join(terms)


class Laurent:
    """Exact finite sums c*tau^p*tstar^q, with rational p,q,c."""
    def __init__(self, terms=None):
        self.terms = {k: F(v) for k, v in (terms or {}).items() if v}

    @classmethod
    def monomial(cls, coefficient=1, tau=0, tstar=0):
        return cls({(F(tau), F(tstar)): F(coefficient)})

    def __add__(self, other):
        other = other if isinstance(other, Laurent) else Laurent.monomial(other)
        result = self.terms.copy()
        for key, value in other.terms.items():
            result[key] = result.get(key, F(0)) + value
        return Laurent(result)

    __radd__ = __add__

    def __neg__(self):
        return Laurent({k: -v for k, v in self.terms.items()})

    def __sub__(self, other):
        return self + (-other if isinstance(other, Laurent) else -F(other))

    def __mul__(self, other):
        other = other if isinstance(other, Laurent) else Laurent.monomial(other)
        result = {}
        for (p1, q1), c1 in self.terms.items():
            for (p2, q2), c2 in other.terms.items():
                key = (p1 + p2, q1 + q2)
                result[key] = result.get(key, F(0)) + c1 * c2
        return Laurent(result)

    __rmul__ = __mul__

    def inverse(self):
        assert len(self.terms) == 1, "Only monomial division is needed"
        ((p, q), c), = self.terms.items()
        return Laurent.monomial(1 / c, -p, -q)

    def __truediv__(self, other):
        if not isinstance(other, Laurent):
            return self * (1 / F(other))
        return self * other.inverse()

    def d_tau(self):
        return Laurent({(p - 1, q): c * p for (p, q), c in self.terms.items() if p})

    def d_T(self):
        return Laurent({(p, q): c * p for (p, q), c in self.terms.items() if p})

    def text(self):
        if not self.terms:
            return "0"
        return " + ".join(f"({c})*tau^({p})*tstar^({q})"
                          for (p, q), c in sorted(self.terms.items()))


def exact_zero(name, residual, identity, assumptions):
    assert not residual.terms, (name, residual.text())
    return {"name": name, "kind": "exact_rational_symbolic_identity",
            "passed": True, "residual": residual.text(),
            "identity": identity, "assumptions": assumptions}


def flrw_checks():
    m = Laurent.monomial
    tau = m(tau=1)
    inv_tau = m(tau=-1)
    h = m(tau=F(2, 3), tstar=-F(2, 3))
    lapse = tau
    k_component = -h / (3 * tau)
    k_trace = -inv_tau
    k_squared = 3 * (k_component / h) * (k_component / h)
    # Work with pi*rho and pi*S to keep every coefficient rational.
    pi_rho = m(F(1, 24), tau=-2)
    pi_pressure = pi_rho
    pi_S_component = pi_rho * h
    pi_S_trace = 3 * pi_rho
    # A=sigma/sqrt(12*pi); Pi=A/tau, phi=phi0+A*ln(tau/tstar).
    normalized_Pi = inv_tau  # Pi/A
    pi_Pi_squared = normalized_Pi * normalized_Pi / 12
    normalized_phi_T = m(1)
    a = m(tau=F(1, 3), tstar=-F(1, 3))
    H = a.d_tau() / a
    domain = ("tau=tstar*exp(T)>0, tstar>0; spatially homogeneous periodic "
              "T^3, signature (-+++), c=G=1, V(phi)=0, "
              "K_ij=-1/2 L_n h_ij, sigma in {-1,1}")
    checks = []
    add = lambda name, residual, identity: checks.append(
        exact_zero(name, residual, identity, domain))
    add("ADM metric evolution", h.d_T() + 2 * lapse * k_component,
        "d_T h_ii = -2*N*K_ii")
    matter_bracket_pi = pi_S_component - h * (pi_S_trace - pi_rho) / 2
    add("scalar matter curvature bracket", matter_bracket_pi,
        "pi*[S_ii-h_ii*(S-rho)/2]=0")
    k_rhs = lapse * (k_trace * k_component
                    - 2 * k_component * k_component / h
                    - 8 * matter_bracket_pi)
    add("ADM curvature evolution", k_component.d_T() - k_rhs,
        "d_T K_ii=N*(K*K_ii-2*K_ik*K^k_i-8*pi*[S_ii-h_ii*(S-rho)/2])")
    add("Hamiltonian constraint", k_trace * k_trace - k_squared - 16 * pi_rho,
        "R3+K^2-K_ij*K^ij-16*pi*rho=0; R3=0")
    add("momentum constraint", m(0),
        "D_j(K^ij-h^ij*K)-8*pi*j^i=0; spatial derivatives and j vanish")
    add("extrinsic curvature definition", k_component + h.d_T() / (2 * lapse),
        "K_ii=-(d_T h_ii)/(2*N), beta=0")
    add("trace curvature evolution", k_trace.d_T()
        - lapse * (k_squared + 4 * (pi_rho + pi_S_trace)),
        "d_T K=N*(K_ij*K^ij+4*pi*(rho+S))")
    add("harmonic lapse", lapse.d_T() + lapse * lapse * k_trace,
        "d_T N=-N^2*K")
    a_cubed = a * a * a
    add("harmonic time flux", (a_cubed / lapse).d_T(),
        "d_T(sqrt(det(h))/N)=d_T(1/tstar)=0")
    add("harmonic shift profile", m(0),
        "d_T beta^i=N^2*Gamma3^i-N*D^i N=0; all spatial coefficients constant")
    add("scalar field evolution", normalized_phi_T - lapse * normalized_Pi,
        "(d_T phi-N*Pi)/A=0, A=sigma/sqrt(12*pi)")
    add("scalar normal momentum evolution", normalized_Pi.d_T()
        - lapse * k_trace * normalized_Pi,
        "[d_T Pi-N*K*Pi]/A=0")
    add("scalar covariant wave equation", normalized_Pi.d_tau()
        + 3 * H * normalized_Pi,
        "[d_tau^2 phi+3*H*d_tau phi]/A=0")
    add("matter energy conservation", pi_rho.d_tau()
        + 3 * H * (pi_rho + pi_pressure),
        "pi*[d_tau rho+3*H*(rho+p)]=0")
    add("matter spatial momentum conservation", m(0),
        "spatial homogeneity and j_i=0 imply spatial divergence equations")
    ricci_00 = -3 * a.d_tau().d_tau() / a
    add("Einstein proper-time temporal component", ricci_00 - 8 * pi_Pi_squared,
        "R_tau,tau-8*pi*(d_tau phi)^2=0")
    ricci_ii = a * a.d_tau().d_tau() + 2 * a.d_tau() * a.d_tau()
    add("Einstein spatial components", ricci_ii,
        "R_ii= a*a''+2*(a')^2 =8*pi*(partial_i phi)^2=0")
    add("scalar stress energy density", pi_rho - pi_Pi_squared / 2,
        "pi*rho=pi*(Pi^2/2)=1/(24*tau^2)")
    return checks


def harmonic_shift_derivation_check():
    # Independent symbols encode product-rule terms for one arbitrary i.
    v = Poly.var
    A, bi, bit = v("A"), v("beta_i"), v("dt_beta_i")
    Aj = [v(f"d{j}_A") for j in range(3)]
    bj = [v(f"beta_{j}") for j in range(3)]
    bij = [v(f"d{j}_beta_i") for j in range(3)]
    bjj = [v(f"d{j}_beta_{j}") for j in range(3)]
    Bj = [v(f"d{j}_B_ij") for j in range(3)]
    At = sum((Aj[j] * bj[j] + A * bjj[j] for j in range(3)), Poly.const(0))
    expanded_flux = At * bi + A * bit
    for j in range(3):
        expanded_flux += Bj[j] - Aj[j] * bi * bj[j] - A * bij[j] * bj[j] - A * bi * bjj[j]
    reduced_flux = A * (bit - sum((bj[j] * bij[j] for j in range(3)), Poly.const(0))) + sum(Bj, Poly.const(0))
    result = exact_zero("general harmonic shift product-rule reduction",
                        expanded_flux - reduced_flux,
                        "partial_t(A*beta_i)+partial_j(B_ij-A*beta_i*beta_j)"
                        " = A*(partial_t-beta^j*partial_j)beta_i+partial_j B_ij",
                        "A=sqrt(det(h))/N; B_ij=N*sqrt(det(h))*h^ij; "
                        "Gamma^0=0 implies partial_t A=partial_j(A*beta^j)")
    result["metric_divergence_identity"] = "partial_j(sqrt(det(h))*h^ij)=-sqrt(det(h))*Gamma3^i"
    result["derived_shift_equation"] = "(partial_t-beta^j*partial_j)beta^i=N^2*Gamma3^i-N*D^i N"
    result["scope"] = "Coordinate components in a Cartesian periodic atlas; use connection differences for a global harmonic-map gauge on a general manifold."
    return result


def shell_algebra_checks():
    v = Poly.var
    V, Vb = v("V"), v("Vb")
    f, a, b, m, fb = [v(x) for x in ("f", "a", "b", "m", "f_b")]
    k1, k2, k3, kd, G = [v(x) for x in ("k1", "k2", "k3", "kd", "G")]
    v1, v2, v3, vd = k1 * f * b, k2 * f * a, k3 * f * a * b, kd * m
    J = G * (fb - f)
    rates = {
        "V*df/dt": J - V * (v1 + v2 + v3),
        "da/dt": v1,
        "db/dt": v2,
        "dm/dt": v3 - vd,
        "dNs/dt": V * vd,
        "Vb*df_b/dt": -J,
    }
    residual = rates["V*df/dt"] + V * rates["da/dt"] + V * rates["db/dt"] + V * rates["dm/dt"] + rates["dNs/dt"] + rates["Vb*df_b/dt"]
    domain = "V,Vb,Ri,vbar,Ds,Kpart,Ns0>0; Ns>=Ns0; k1,k2,k3,kd>=0; f,a,b,m,f_b>=0"
    conservation = exact_zero("shell-core-reservoir monomer conservation", residual,
                              "d_t[V*(f+a+b+m)+Ns+Vb*f_b]=0", domain)
    faces = [
        ("f=0", rates["V*df/dt"].zero_at("f"), "V>0"),
        ("a=0", rates["da/dt"].zero_at("a"), "1"),
        ("b=0", rates["db/dt"].zero_at("b"), "1"),
        ("m=0", rates["dm/dt"].zero_at("m"), "1"),
        ("Ns=Ns0", rates["dNs/dt"], "1"),
        ("f_b=0", rates["Vb*df_b/dt"].zero_at("f_b"), "Vb>0"),
    ]
    inward = []
    for face, numerator, denominator in faces:
        assert numerator.is_nonnegative_on_orthant()
        inward.append({"face": face, "nonnegative_numerator": numerator.text(),
                       "positive_denominator": denominator, "passed": True})
    # Differentiate conductance by the exact quotient rule. C abbreviates
    # 4*pi*Ds*Kpart>0, and R is the independent outer-radius coordinate.
    R, Ri, C = v("R"), v("Ri"), v("C")
    numerator, denominator = C * Ri * R, R - Ri
    derivative_numerator = (numerator.derivative("R") * denominator
                            - numerator * denominator.derivative("R"))
    expected_numerator = -C * Ri * Ri
    conductance_derivative = exact_zero(
        "spherical shell conductance derivative", derivative_numerator - expected_numerator,
        "(R-Ri)^2*d_R[C*Ri*R/(R-Ri)] = -C*Ri^2",
        "C=4*pi*Ds*Kpart>0, R>Ri>0")
    return {
        "conservation": conservation,
        "inward_face_signs": {"kind": "exact_nonnegative_polynomial_coefficients",
                              "passed": True, "domain": domain, "faces": inward},
        "conductance_domain": {
            "kind": "analytic_definition_and_derivation", "passed": True,
            "Ro": "(Ri^3+3*vbar*Ns/(4*pi))^(1/3)",
            "G": "4*pi*Ds*Kpart*Ri*Ro/(Ro-Ri)",
            "dRo_dNs": "vbar/(4*pi*Ro^2)>0",
            "dG_dRo": "-4*pi*Ds*Kpart*Ri^2/(Ro-Ri)^2<0",
            "exact_derivative_check": conductance_derivative,
            "bounds": "Ro>=Ro(Ns0)>Ri and 0<G(Ns)<=G(Ns0)",
        },
        "global_solution_proof": [
            "The displayed face polynomials prove forward invariance of f,a,b,m,f_b>=0 and Ns>=Ns0.",
            "The exact conserved total bounds every concentration and stored shell amount.",
            "Ns>=Ns0>0 implies Ro-Ri>=Ro(Ns0)-Ri>0, so the vector field is smooth on a neighbourhood of the bounded invariant state set.",
            "Local uniqueness and the ODE continuation theorem therefore give a unique solution for every finite future time; no state clipping or rollback is part of the equations.",
        ],
    }


def shell_numerical_checks():
    params = {"Ri": 1.0, "Vb_over_V": 2.0, "vbar": 0.1, "Ds": 0.002,
              "Kpart": 0.8, "k1": 0.4, "k2": 0.3, "k3": 0.7, "kd": 0.2}
    V = 4 * math.pi / 3
    Vb = 2 * V
    initial = np.array([0.6, 0.15, 0.12, 0.0, 0.4, 1.2], dtype=float)
    weights = np.array([V, V, V, V, 1.0, Vb])
    initial_total = float(weights @ initial)

    def geometry(Ns):
        Ro = (1 + 3 * params["vbar"] * Ns / (4 * math.pi)) ** (1 / 3)
        G = 4 * math.pi * params["Ds"] * params["Kpart"] * Ro / (Ro - 1)
        return Ro, G

    def rhs(y):
        f, a, b, m, Ns, fb = y
        _, G = geometry(Ns)
        J = G * (fb - f)
        v1 = params["k1"] * f * b
        v2 = params["k2"] * f * a
        v3 = params["k3"] * f * a * b
        vd = params["kd"] * m
        return np.array([J / V - v1 - v2 - v3, v1, v2, v3 - vd,
                         V * vd, -J / Vb])

    def integrate(dt, end=40.0):
        count = int(round(end / dt))
        y = initial.copy()
        drift = 0.0
        minimum = y.copy()
        lowest_shell_increment = math.inf
        for _ in range(count):
            k1 = rhs(y)
            k2 = rhs(y + dt * k1 / 2)
            k3 = rhs(y + dt * k2 / 2)
            k4 = rhs(y + dt * k3)
            new = y + dt * (k1 + 2*k2 + 2*k3 + k4) / 6
            lowest_shell_increment = min(lowest_shell_increment, float(new[4] - y[4]))
            y = new
            drift = max(drift, abs(float(weights @ y) - initial_total))
            minimum = np.minimum(minimum, y)
        Ro, G = geometry(y[4])
        assert np.isfinite(y).all()
        assert minimum.min() >= -1e-13
        assert drift < 1e-10
        assert lowest_shell_increment >= -1e-13
        return {"step": dt, "steps": count, "end_time": end,
                "final_state": y.tolist(), "minimum_state_over_samples": minimum.tolist(),
                "maximum_total_amount_residual": drift,
                "minimum_shell_amount_increment": lowest_shell_increment,
                "final_outer_radius": Ro, "final_conductance": G}

    runs = [integrate(dt) for dt in (0.02, 0.01, 0.005)]
    differences = [float(np.max(np.abs(np.array(runs[i]["final_state"])
                                      - np.array(runs[i+1]["final_state"]))))
                   for i in range(2)]
    ratio = differences[0] / differences[1]
    assert differences[1] < differences[0]
    # Convergence ratio is only an observed diagnostic; not a proof gate.
    return {"kind": "representative_numerical_RK4_integrations", "passed": True,
            "state_order": ["f", "a", "b", "m", "Ns", "f_b"],
            "parameters": params, "initial_state": initial.tolist(),
            "core_volume": V, "reservoir_volume": Vb, "initial_total_amount": initial_total,
            "runs": runs, "successive_final_state_max_norm_differences": differences,
            "observed_difference_ratio": ratio,
            "scope": "Numerical examples for the displayed well-mixed physical reactor ODE. Positivity/global existence follow from the separate analytic invariant-set proof. RK4 itself has no unconditional positivity assertion; no clipping was used."}


def main():
    flrw = flrw_checks()
    shift = harmonic_shift_derivation_check()
    shell = shell_algebra_checks()
    numerical = shell_numerical_checks()
    result = {
        "title": "XD-TAU v1.4 ADM/scalar and shell reactor verification",
        "method": "Python Fraction exact sparse algebra; NumPy float64 RK4 only for labelled numerical examples",
        "python_version": platform.python_version(), "numpy_version": np.__version__,
        "all_checks_passed": True, "exact_flrw_identity_count": len(flrw),
        "flrw_exact_checks": flrw, "general_harmonic_shift": shift,
        "shell_analytic_checks": shell, "shell_numerical_examples": numerical,
        "continuum_theorem_scope": {
            "Einstein_scalar": "Smooth periodic initial h>0,K symmetric,phi,Pi satisfying Hamiltonian/momentum constraints; N0>0 and smooth shift with harmonic initial gauge derivatives; smooth V (massless reference V=0). Harmonic reduction yields unique local gauge-fixed smooth development; geometric uniqueness is modulo diffeomorphism. The exact FLRW profile is defined for all T>=0.",
            "NSF_reference": "Periodic ideal-gas Navier-Stokes-Fourier data in H^s, s>=6, positive initial density/temperature, positive constant shear viscosity/conductivity and lambda_v>=0. Local strong solution theorem; an arbitrary numerical flux or arbitrary coupled PDE does not inherit that theorem automatically.",
            "distinction": "Exact identity checks establish the particular identities. The stated standard local PDE theorems and the supplied ODE continuation argument provide their respective existence scopes. No universal global regularity statement for all PDE couplings is claimed."
        },
        "references": [
            {"citation": "E. Gourgoulhon, 3+1 Formalism and Bases of Numerical Relativity (2007)", "url": "https://arxiv.org/abs/gr-qc/0703035", "scope": "ADM signs, matter split and gauge"},
            {"citation": "H. Friedrich and A. D. Rendall, The Cauchy Problem for the Einstein Equations (2000), sections 5.1-5.2", "url": "https://arxiv.org/html/gr-qc/0002074", "scope": "harmonic-map reduction, gauge propagation, geometric uniqueness"},
            {"citation": "A. D. Rendall, Theorems on Existence and Global Dynamics for the Einstein Equations (2005), section 2.5", "url": "https://arxiv.org/html/gr-qc/0505133", "scope": "local existence with scalar matter"},
            {"citation": "D. Basaric et al., Error estimates of a finite volume method for the compressible Navier-Stokes-Fourier system (2022), Appendix A", "url": "https://arxiv.org/html/2210.15561", "scope": "periodic smooth-data local NSF theory; additional hypotheses needed for numerical convergence"},
        ],
    }
    target = Path(__file__).with_name("v14_adm_shell_results.json")
    target.write_text(json.dumps(result, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps({"output": str(target), "passed": True,
                      "exact_flrw_identities": len(flrw),
                      "general_shift_residual": shift["residual"],
                      "shell_total_residual": shell["conservation"]["residual"],
                      "shell_face_signs": len(shell["inward_face_signs"]["faces"]),
                      "numerical_max_amount_residual": max(r["maximum_total_amount_residual"] for r in numerical["runs"]),
                      "RK4_observed_difference_ratio": numerical["observed_difference_ratio"]}, indent=2))


if __name__ == "__main__":
    main()

endstream
