      "minimum_internal_energy_density": 2.338269512097701,
      "minimum_body_heat": 4.008306650398396,
      "minimum_species": 0.05031151047732162,
      "minimum_derived_radius": 1.088589124192802,
      "max_convex_weight": 0.6500000000000001,
      "max_viscous_power_residual": 7.074419175467916e-18,
      "final_physical_time": 3.073031136701707
    },
    {
      "name": "IEEE64_hex_round_trip_and_replay",
      "passed": true,
      "round_trips": 64,
      "representation": "canonical float.hex / float.fromhex; array shape retained by nesting",
      "scope": "same runtime and arithmetic evaluation order; no cross-platform libm bitwise claim"
    },
    {
      "name": "BE_is_not_mislabeled_exact_exponential",
      "passed": true,
      "max_pair_difference": 0.7458553831691388,
