    "replacement": "Equality holds under strict differentiability, including C1 regularity in a neighborhood.",
    "witness": "F(x)=x+x^2 sin(1/x), F(0)=0: F'(0)=1, partial^C F(0)=[0,2]."
  },
  "checks": [
    {
      "name": "exhaustive_regular_closed_slab_boolean_algebra",
      "passed": true,
      "evidence_kind": "exact finite geometric regression, not general theorem proof",
      "ambient_space": "R^3; slab coordinate x_1; transverse factor R^2",
      "full_dimensional_cells": 4,
      "regions": 16,
      "ordered_pairs": 256,
      "ordered_triples": 4096,
      "pair_law_assertions": 2304,
      "triple_law_assertions": 16384,
      "laws": [
        "identity",
        "annihilation",
        "idempotence",
