stream
"""Executable finite reference profiles for XD-TAU v1.4.

The Fraction profile is an exact rational DISCRETE model. Its pair diffusion,
reaction and attenuation maps are first-order backward-Euler consistency schemes,
not exact exponential flows. The float profile evaluates exact linear subflow
formulas and a specified first-order split compressible-fluid model using NumPy
float64. Floating calculations satisfy balances to reported residuals, not
bitwise exact conservation. Both profiles use explicit causal stage ordering;
there are no retries, clipping, rejection, rollback or state repair branches.

Domain: positive masses, capacities and volumes; nonnegative conductances,
absorption and rates; h >= 0; quadratic energy matrix Q >= 0, skew J, PSD R.
The fluid profile uses gamma > 1, positive density/internal energy and its direct
CFL time schedule. Typed events contain positive beam power and finite forcing.
Assertions are verification code, separate from all evolution functions.

Run with the bundled Python executable; writes v14_reference_results.json.
"""

from __future__ import annotations

import copy
import json
import math
import platform
from fractions import Fraction as F
from pathlib import Path

import numpy as np


OUT = Path(__file__).with_name("v14_reference_results.json")
RATIONAL_ORDER = [
    "events", "coefficient_snapshot", "midpoint_mechanics", "quadratic_drag",
    "reaction_BE", "attenuation_BE", "heat_pair_BE", "species_pair_BE",
    "neural_information", "geometry_outputs", "clock",
]
FLOAT_ORDER = [
    "events", "coefficient_snapshot_and_CFL", "midpoint_mechanics",
    "quadratic_drag", "periodic_Rusanov_Euler", "viscous_midpoint_heat",
    "reaction_exponential", "optical_exponential", "heat_pair_exponential",
    "species_pair_exponential", "neural_information", "geometry_outputs", "clock",
]


def fmvec(a, x):
    return [sum((v * w for v, w in zip(row, x)), F(0)) for row in a]


def fmmul(a, b):
    return [[sum((a[i][k] * b[k][j] for k in range(len(b))), F(0))
             for j in range(len(b[0]))] for i in range(len(a))]


def ftranspose(a):
    return [list(row) for row in zip(*a)]


def fdot(a, b):
    return sum((u * v for u, v in zip(a, b)), F(0))


def fsolve(a, b):
    """Exact Gaussian elimination; nonsingularity is a mathematical input domain."""
    n = len(b)
    z = [[F(v) for v in row] + [F(bi)] for row, bi in zip(a, b)]
    for j in range(n):
        pivot = next(i for i in range(j, n) if z[i][j])
        z[j], z[pivot] = z[pivot], z[j]
        d = z[j][j]
        z[j] = [v / d for v in z[j]]
        for i in range(n):
            if i != j:
                aij = z[i][j]
                z[i] = [u - aij * v for u, v in zip(z[i], z[j])]
    return [row[-1] for row in z]


def fenergy(x, q):
    return fdot(x, fmvec(q, x)) / 2


def midpoint_fraction(x, q, j, r, h, forcing):
    """Frozen-coefficient linear midpoint; returns state, heat and supplied work."""
    n = len(x)
    a = fmmul([[j[i][k] - r[i][k] for k in range(n)] for i in range(n)], q)
    minus = [[F(i == k) - h * a[i][k] / 2 for k in range(n)] for i in range(n)]
    plus = [[F(i == k) + h * a[i][k] / 2 for k in range(n)] for i in range(n)]
    rhs = [v + h * f for v, f in zip(fmvec(plus, x), forcing)]
    new = fsolve(minus, rhs)
    g = fmvec(q, [(v + w) / 2 for v, w in zip(x, new)])
    heat = h * fdot(g, fmvec(r, g))
    work = h * fdot(g, forcing)
    return new, heat, work


def midpoint_float(x, q, j, r, h, forcing):
    a = (j - r) @ q
    new = np.linalg.solve(np.eye(len(x)) - h * a / 2,
                          (np.eye(len(x)) + h * a / 2) @ x + h * forcing)
    g = q @ ((x + new) / 2)
    return new, float(h * g @ r @ g), float(h * g @ forcing)


def pair_diffusion_BE(amounts, capacities, i, j, conductance, h):
    """Exact rational solution of the pair's BE equations; first-order in h."""
    out = list(amounts)
    ci, cj = capacities[i], capacities[j]
    ti, tj = amounts[i] / ci, amounts[j] / cj
    mean = (amounts[i] + amounts[j]) / (ci + cj)
    difference = (ti - tj) / (1 + h * conductance * (1 / ci + 1 / cj))
    out[i] = ci * (mean + cj * difference / (ci + cj))
    out[j] = cj * (mean - ci * difference / (ci + cj))
    return out


def pair_diffusion_exponential(amounts, capacities, i, j, conductance, h):
    """Exact real-arithmetic pair flow formula, evaluated in float64."""
    out = np.array(amounts, dtype=np.float64, copy=True)
    ci, cj = capacities[i], capacities[j]
    ti, tj = amounts[i] / ci, amounts[j] / cj
    mean = (amounts[i] + amounts[j]) / (ci + cj)
    difference = (ti - tj) * math.exp(-h * conductance * (1 / ci + 1 / cj))
    out[i] = ci * (mean + cj * difference / (ci + cj))
    out[j] = cj * (mean - ci * difference / (ci + cj))
    return out


def reaction_BE(c, rates, h):
    """Lie composition of three first-order rational BE reaction substeps."""
    f, a, b, m = c
    next_f = f / (1 + h * rates[0] * b)
    a, f = a + f - next_f, next_f
    next_f = f / (1 + h * rates[1] * a)
    b, f = b + f - next_f, next_f
    next_f = f / (1 + h * rates[2] * a * b)
    m, f = m + f - next_f, next_f
    return [f, a, b, m]


def reaction_exponential(c, rates, h):
    """Exact elementary subflows, composed in R1,R2,R3 order (Lie order 1)."""
    f, a, b, m = (float(v) for v in c)
    next_f = f * math.exp(-h * rates[0] * b)
    a, f = a + f - next_f, next_f
    next_f = f * math.exp(-h * rates[1] * a)
    b, f = b + f - next_f, next_f
    next_f = f * math.exp(-h * rates[2] * a * b)
    m, f = m + f - next_f, next_f
    return np.array([f, a, b, m], dtype=np.float64)


def drag_scalar_fraction(v1, v2, m1, m2, coefficient, h):
    total = m1 + m2
    reduced = m1 * m2 / total
    center = (m1 * v1 + m2 * v2) / total
    relative = v1 - v2
    new_relative = relative / (1 + h * coefficient * abs(relative) / reduced)
    new1 = center + m2 * new_relative / total
    new2 = center - m1 * new_relative / total
    heat = reduced * (relative * relative - new_relative * new_relative) / 2
    return new1, new2, heat


def drag_vector_float(v1, v2, m1, m2, coefficient, h):
    v1, v2 = np.asarray(v1, dtype=np.float64), np.asarray(v2, dtype=np.float64)
    total = m1 + m2
    reduced = m1 * m2 / total
    center = (m1 * v1 + m2 * v2) / total
    relative = v1 - v2
    new_relative = relative / (1 + h * coefficient * np.linalg.norm(relative) / reduced)
    new1 = center + m2 * new_relative / total
    new2 = center - m1 * new_relative / total
    heat = float(reduced * (relative @ relative - new_relative @ new_relative) / 2)
    return new1, new2, heat


def attenuation_BE(energy, kappas, lengths):
    """First-order spatial BE attenuation; exact rational packet bookkeeping."""
    heat = []
    for kappa, length in zip(kappas, lengths):
        output = energy / (1 + kappa * length)
        heat.append(energy - output)
        energy = output
    return energy, heat


def optical_exponential(energy, kappas, lengths):
    heat = []
    for kappa, length in zip(kappas, lengths):
        output = energy * math.exp(-kappa * length)
        heat.append(energy - output)
        energy = output
    return float(energy), np.array(heat, dtype=np.float64)


def rational_total(s):
    q, p = s["mechanical"]
    mechanical = (3 * q * q + p * p / 2) / 2
    medium = 5 * s["medium_velocity"] ** 2 / 2
    chemical = sum((v * 3 * c[0] for v, c in zip(s["volumes"], s["chemistry"])), F(0))
    return mechanical + medium + sum(s["heat"], F(0)) + chemical


def rational_amount(s):
    return sum((v * sum(c, F(0)) for v, c in zip(s["volumes"], s["chemistry"])), F(0))


def rational_geometry(s):
    return [1 + e / (10 * cap) + c[3] / 100
            for e, cap, c in zip(s["heat"], s["capacities"], s["chemistry"])]


def rational_initial():
    s = {
        "n": 0, "time": F(0), "mechanical": [F(2, 3), F(5, 4)],
        "medium_velocity": F(-1, 3),
        "capacities": [F(2), F(3), F(5)], "volumes": [F(1), F(2), F(3)],
        "heat": [F(4), F(7), F(9)],
        "chemistry": [[F(3), F(1, 2), F(1, 4), F(0)],
                      [F(2), F(1, 3), F(1, 2), F(1, 5)],
                      [F(5, 2), F(1, 4), F(3, 4), F(1, 6)]],
        "neural": [F(1, 3), F(-1, 4), F(1, 5)], "fit_parameter": F(1),
        "bits": [0, 1, 1], "operations": [],
        "ledger": {"work": F(0), "beam_in": F(0), "beam_out": F(0)},
    }
    s["radii"] = rational_geometry(s)
    return s


def rational_step(state, event, h):
    """A complete causal rational state update; every physical transfer is booked."""
    s = copy.deepcopy(state)
    trace = []
    before = rational_total(s)
    stage_expected = F(0)

    def record(stage):
        trace.append({"stage": stage, "energy_balance_residual": rational_total(s) - before - stage_expected})

    tag = event["tag"]
    is_new = tag not in s["operations"]
    s["operations"] = sorted(set(s["operations"]) | {tag})
    if is_new:
        s["bits"] = [a ^ b for a, b in zip(s["bits"], event["xor"])]
    record("events")
    temperatures = [e / c for e, c in zip(s["heat"], s["capacities"])]
    radii = rational_geometry(s)
    kappas = [(1 + t / 10) / 4 for t in temperatures]
    lengths = [r / 3 for r in radii]
    rates = [[(1 + t / 10) / 8, F(1, 10), F(1, 20)] for t in temperatures]
    edges = [(0, 1, F(1, 5) / (1 + (radii[0] - radii[1]) ** 2)),
             (1, 2, F(1, 6) / (1 + (radii[1] - radii[2]) ** 2))]
    if s["bits"][0]:
        edges.append((0, 2, F(1, 9) / (1 + (radii[0] - radii[2]) ** 2)))
    old_neural = list(s["neural"])
    record("coefficient_snapshot")

    s["mechanical"], heat, work = midpoint_fraction(
        s["mechanical"], [[F(3), F(0)], [F(0), F(1, 2)]],
        [[F(0), F(1)], [F(-1), F(0)]], [[F(0), F(0)], [F(0), F(1, 4)]],
        h, [F(0), event["force"]])
    s["heat"][0] += heat
    s["ledger"]["work"] += work
    stage_expected += work
    record("midpoint_mechanics")

    v1, v2, heat = drag_scalar_fraction(s["mechanical"][1] / 2,
                                       s["medium_velocity"], F(2), F(5), F(1, 7), h)
    s["mechanical"][1] = 2 * v1
    s["medium_velocity"] = v2
    s["heat"][1] += heat
    record("quadratic_drag")

    for i, volume in enumerate(s["volumes"]):
        old_f = s["chemistry"][i][0]
        s["chemistry"][i] = reaction_BE(s["chemistry"][i], rates[i], h)
        s["heat"][i] += 3 * volume * (old_f - s["chemistry"][i][0])
    record("reaction_BE")

    beam_in = h * event["beam_power"]
    beam_out, heat = attenuation_BE(beam_in, kappas, lengths)
    s["heat"] = [e + q for e, q in zip(s["heat"], heat)]
    s["ledger"]["beam_in"] += beam_in
    s["ledger"]["beam_out"] += beam_out
    stage_expected += beam_in - beam_out
    record("attenuation_BE")

    for i, j, g in edges:
        s["heat"] = pair_diffusion_BE(s["heat"], s["capacities"], i, j, g, h)
    record("heat_pair_BE")

    for species in range(4):
        amounts = [volume * c[species] for volume, c in zip(s["volumes"], s["chemistry"])]
        for i, j, g in edges:
            amounts = pair_diffusion_BE(amounts, s["volumes"], i, j, g / 4, h)
        for i, volume in enumerate(s["volumes"]):
            s["chemistry"][i][species] = amounts[i] / volume
    record("species_pair_BE")

    response = [z / (1 + abs(z)) for z in old_neural]
    for i in range(3):
        drive = temperatures[i] / 30 + sum(response[j] for j in range(3) if j != i) / 10
        s["neural"][i] = (old_neural[i] + h * drive) / (1 + h / 2)
    target = sum(radii, F(0)) / 3
    s["fit_parameter"] -= h * (s["fit_parameter"] - target) / 10
    record("neural_information")
    s["radii"] = rational_geometry(s)
    record("geometry_outputs")
    s["time"] += h
    s["n"] += 1
    record("clock")
    return s, trace


def encode_rational(value):
    if isinstance(value, F):
        return {"$qhex": [format(value.numerator, "x"), format(value.denominator, "x")]}
    if isinstance(value, dict):
        return {k: encode_rational(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [encode_rational(v) for v in value]
    if isinstance(value, (str, int, bool)) or value is None:
        return value
    raise TypeError(f"Outside finite rational serialization domain: {type(value).__name__}")


def decode_rational(value):
    if isinstance(value, dict):
        if set(value) == {"$qhex"}:
            p, q = value["$qhex"]
            return F(int(p, 16), int(q, 16))
        return {k: decode_rational(v) for k, v in value.items()}
    if isinstance(value, list):
        return [decode_rational(v) for v in value]
    return value


def rational_json(s):
    return json.dumps(encode_rational(s), sort_keys=True, separators=(",", ":"))


def euler_flux(U, gamma):
    rho, momentum, energy = U[:, 0], U[:, 1], U[:, 2]
    velocity = momentum / rho
    pressure = (gamma - 1) * (energy - momentum * momentum / (2 * rho))
    return np.column_stack((momentum, momentum * velocity + pressure, (energy + pressure) * velocity))


def euler_face_data(U, gamma):
    rho, momentum, energy = U[:, 0], U[:, 1], U[:, 2]
    velocity = momentum / rho
    pressure = (gamma - 1) * (energy - momentum * momentum / (2 * rho))
    speed = np.abs(velocity) + np.sqrt(gamma * pressure / rho)
    alpha = np.maximum(speed, np.roll(speed, -1))
    return alpha


def euler_cfl_step(U, dx, gamma=1.4, sigma=0.65):
    alpha = euler_face_data(U, gamma)
    return float(sigma * np.min(2 * dx / (alpha + np.roll(alpha, 1))))


def rusanov_periodic(U, dx, h, gamma=1.4):
    flux = euler_flux(U, gamma)
    alpha = euler_face_data(U, gamma)
    face = (flux + np.roll(flux, -1, axis=0)
            - alpha[:, None] * (np.roll(U, -1, axis=0) - U)) / 2
    new = U - h / dx * (face - np.roll(face, 1, axis=0))
    weights = h * (alpha + np.roll(alpha, 1)) / (2 * dx)
    return new, float(np.max(weights))


def viscous_midpoint_heat(U, dx, h, viscosity=0.08):
    """Compatible 1-D periodic viscosity: B forward differences, W=dx I."""
    n = len(U)
    masses = dx * U[:, 0]
    momenta = dx * U[:, 1]
    B = np.zeros((n, n))
    for i in range(n):
        B[i, i] = -1 / dx
        B[i, (i + 1) % n] = 1 / dx
    D = viscosity * dx * B.T @ B
    inverse_mass = np.diag(1 / masses)
    pnew = np.linalg.solve(np.eye(n) + h * D @ inverse_mass / 2,
                          (np.eye(n) - h * D @ inverse_mass / 2) @ momenta)
    vbar = (momenta + pnew) / (2 * masses)
    edge_heat = h * viscosity * dx * (B @ vbar) ** 2
    heat = (edge_heat + np.roll(edge_heat, 1)) / 2
    old_k = momenta * momenta / (2 * masses)
    new_k = pnew * pnew / (2 * masses)
    out = np.array(U, copy=True)
    out[:, 1] = pnew / dx
    out[:, 2] += (new_k - old_k + heat) / dx
    diagnostics = {
        "kinetic_plus_heat_residual": float(np.sum(new_k - old_k) + np.sum(heat)),
        "momentum_residual": float(np.sum(pnew) - np.sum(momenta)),
        "minimum_heat_deposit": float(np.min(heat)),
    }
    return out, diagnostics


def internal_energy_density(U):
    return U[:, 2] - U[:, 1] ** 2 / (2 * U[:, 0])


def float_total(s):
    q, p = s["mechanical"]
    return float((3 * q * q + p * p / 2) / 2 + 5 * s["medium_velocity"] ** 2 / 2
                 + np.sum(s["body_heat"]) + s["dx"] * np.sum(s["fluid"][:, 2])
                 + 2 * s["dx"] * np.sum(s["chemistry"][:, 0]))


def float_amount(s):
    return float(s["dx"] * np.sum(s["chemistry"]))


def float_initial(n=8):
    x = (np.arange(n) + 0.5) / n
    rho = 1 + 0.15 * np.sin(2 * np.pi * x)
    velocity = 0.2 + 0.1 * np.cos(2 * np.pi * x)
    pressure = 1 + 0.2 * np.sin(4 * np.pi * x)
    fluid = np.column_stack((rho, rho * velocity, pressure / 0.4 + rho * velocity ** 2 / 2))
    chemistry = np.column_stack((2 + 0.1 * np.sin(2 * np.pi * x),
                                 np.full(n, 0.3), np.full(n, 0.2), np.full(n, 0.05)))
    return {"n": 0, "time": 0.0, "mechanical": np.array([2 / 3, 5 / 4]),
            "medium_velocity": -1 / 3, "body_heat": np.array([4.0, 7.0]),
            "body_capacities": np.array([2.0, 3.0]), "fluid": fluid, "dx": 1 / n,
            "gamma": 1.4, "cv": 2.5, "chemistry": chemistry,
            "neural": 0.1 * np.sin(2 * np.pi * x), "fit_parameter": 1.0,
            "bits": [0, 1, 1], "operations": [],
            "ledger": {"work": 0.0, "beam_in": 0.0, "beam_out": 0.0}}


def float_step(state, event):
    """Causal finite coupled reference including nonlinear compressible fluid."""
    s = copy.deepcopy(state)
    trace = []
    initial_energy = float_total(s)
    expected = 0.0

    def record(stage):
        trace.append({"stage": stage, "energy_balance_residual": float_total(s) - initial_energy - expected})

    tag = event["tag"]
    is_new = tag not in s["operations"]
    s["operations"] = sorted(set(s["operations"]) | {tag})
    if is_new:
        s["bits"] = [a ^ b for a, b in zip(s["bits"], event["xor"])]
    record("events")
    h = euler_cfl_step(s["fluid"], s["dx"], s["gamma"])
    old_temperature = internal_energy_density(s["fluid"]) / (s["fluid"][:, 0] * s["cv"])
    body_temperature = s["body_heat"] / s["body_capacities"]
    radii = 1 + old_temperature / 10 + s["chemistry"][:, 3] / 100
    kappas = 0.25 * np.exp(0.1 * (old_temperature - 1))
    lengths = s["dx"] * radii
    rates = np.column_stack((0.12 * np.exp(0.02 * (old_temperature - 1)),
                             np.full(len(radii), 0.1), np.full(len(radii), 0.05)))
    old_neural = s["neural"].copy()
    record("coefficient_snapshot_and_CFL")

    s["mechanical"], heat, work = midpoint_float(
        s["mechanical"], np.diag([3.0, 0.5]), np.array([[0., 1.], [-1., 0.]]),
        np.diag([0.0, 0.25]), h, np.array([0.0, event["force"]]))
    s["body_heat"][0] += heat
    s["ledger"]["work"] += work
    expected += work
    record("midpoint_mechanics")

    v1, v2, heat = drag_vector_float([s["mechanical"][1] / 2], [s["medium_velocity"]],
                                     2.0, 5.0, 1 / 7, h)
    s["mechanical"][1], s["medium_velocity"] = 2 * float(v1[0]), float(v2[0])
    s["body_heat"][1] += heat
    record("quadratic_drag")

    s["fluid"], cfl_weight = rusanov_periodic(s["fluid"], s["dx"], h, s["gamma"])
    record("periodic_Rusanov_Euler")
    s["fluid"], viscous_diagnostics = viscous_midpoint_heat(s["fluid"], s["dx"], h)
    record("viscous_midpoint_heat")

    for i in range(len(s["chemistry"])):
        old_f = s["chemistry"][i, 0]
        s["chemistry"][i] = reaction_exponential(s["chemistry"][i], rates[i], h)
        s["fluid"][i, 2] += 2 * (old_f - s["chemistry"][i, 0])
    record("reaction_exponential")

    beam_in = h * event["beam_power"]
    beam_out, deposited = optical_exponential(beam_in, kappas, lengths)
    s["fluid"][:, 2] += deposited / s["dx"]
    s["ledger"]["beam_in"] += beam_in
    s["ledger"]["beam_out"] += beam_out
    expected += beam_in - beam_out
    record("optical_exponential")

    n = len(s["fluid"])
    capacities = np.concatenate((s["body_capacities"], s["dx"] * s["fluid"][:, 0] * s["cv"]))
    amounts = np.concatenate((s["body_heat"], s["dx"] * internal_energy_density(s["fluid"])))
    edges = [(0, 1, 0.2), (1, 2, 0.15 / (1 + (body_temperature[1] - old_temperature[0]) ** 2))]
    edges += [(i + 2, (i + 1) % n + 2, 0.1 / (1 + (radii[i] - radii[(i + 1) % n]) ** 2))
              for i in range(n)]
    if s["bits"][0]:
        edges.append((0, n // 2 + 2, 0.05))
    for i, j, g in edges:
        amounts = pair_diffusion_exponential(amounts, capacities, i, j, g, h)
    s["body_heat"] = amounts[:2]
    kinetic_density = s["fluid"][:, 1] ** 2 / (2 * s["fluid"][:, 0])
    s["fluid"][:, 2] = kinetic_density + amounts[2:] / s["dx"]
    record("heat_pair_exponential")

    volumes = np.full(n, s["dx"])
    for species in range(4):
        amounts = volumes * s["chemistry"][:, species]
        for i in range(n):
            amounts = pair_diffusion_exponential(amounts, volumes, i, (i + 1) % n, 0.02, h)
        s["chemistry"][:, species] = amounts / volumes
    record("species_pair_exponential")

    drive = 0.1 * (np.roll(np.tanh(old_neural), -1) + np.roll(np.tanh(old_neural), 1)) + old_temperature / 30
    decay = math.exp(-0.5 * h)
    s["neural"] = decay * old_neural + (1 - decay) / 0.5 * drive
    s["fit_parameter"] -= h / 10 * (s["fit_parameter"] - float(np.mean(radii)))
    record("neural_information")
    new_temperature = internal_energy_density(s["fluid"]) / (s["fluid"][:, 0] * s["cv"])
    s["radii"] = 1 + new_temperature / 10 + s["chemistry"][:, 3] / 100
    record("geometry_outputs")
    s["time"] += h
    s["n"] += 1
    record("clock")
    return s, trace, {"h": h, "max_convex_weight": cfl_weight, **viscous_diagnostics}


def hex_encode(value):
    if isinstance(value, np.ndarray):
        return {"$array": hex_encode(value.tolist())}
    if isinstance(value, (float, np.floating)):
        return {"$f64": float(value).hex()}
    if isinstance(value, dict):
        return {k: hex_encode(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [hex_encode(v) for v in value]
    return value


def hex_decode(value):
    if isinstance(value, dict):
        if set(value) == {"$f64"}:
            return float.fromhex(value["$f64"])
        if set(value) == {"$array"}:
            return np.array(hex_decode(value["$array"]), dtype=np.float64)
        return {k: hex_decode(v) for k, v in value.items()}
    if isinstance(value, list):
        return [hex_decode(v) for v in value]
    return value


def run_verification():
    exact = []
    floating = []

    def echeck(name, condition, **evidence):
        exact.append({"name": name, "passed": bool(condition), **evidence})
        assert condition, name

    def fcheck(name, condition, **evidence):
        floating.append({"name": name, "passed": bool(condition), **evidence})
        assert condition, name

    # General exact matrix midpoint: non-diagonal Q, skew J, PSD R and finite forcing.
    C = [[F(2), F(1), F(0)], [F(0), F(3), F(1)], [F(1), F(0), F(2)]]
    q = fmmul(ftranspose(C), C)
    j = [[F(0), F(2), F(-1)], [F(-2), F(0), F(3)], [F(1), F(-3), F(0)]]
    D = [[F(1), F(2), F(0)], [F(0), F(1), F(1)]]
    r = fmmul(ftranspose(D), D)
    x, h, forcing = [F(2, 3), F(-4, 5), F(7, 8)], F(11, 7), [F(1, 4), F(-1, 3), F(2, 5)]
    new, heat, work = midpoint_fraction(x, q, j, r, h, forcing)
    residual = fenergy(new, q) - fenergy(x, q) + heat - work
    echeck("general_fraction_midpoint_power_balance", residual == 0 and heat >= 0,
           energy_residual=str(residual), heat=str(heat), supplied_work=str(work))

    # Semidefinite Q has a zero-energy coordinate; invertibility does not need SPD Q.
    q0 = [[F(1), F(0)], [F(0), F(0)]]
    new0, d0, w0 = midpoint_fraction([F(2), F(5)], q0, [[F(0), F(1)], [F(-1), F(0)]],
                                     [[F(0), F(0)], [F(0), F(0)]], F(100), [F(0), F(0)])
    echeck("semidefinite_Q_midpoint", new0 == [F(2), F(-195)] and d0 == w0 == 0,
           state=[str(v) for v in new0])

    n = [F(7), F(1)]
    c = [F(2), F(3)]
    nd = pair_diffusion_BE(n, c, 0, 1, F(5, 7), F(13, 4))
    entropy_before = sum(float(ci) * math.log(float(ni / ci)) for ni, ci in zip(n, c))
    entropy_after = sum(float(ci) * math.log(float(ni / ci)) for ni, ci in zip(nd, c))
    echeck("fraction_BE_pair_conservation_and_positive", sum(nd) == sum(n) and min(nd) > 0,
           amount_residual=str(sum(nd) - sum(n)), new_amounts=[str(v) for v in nd],
           scheme="backward Euler pair; first order, not exact flow")
    fcheck("BE_pair_entropy_example", entropy_after >= entropy_before,
           entropy_increase=entropy_after - entropy_before)
    source = [F(3), F(1, 2), F(1, 4), F(1, 3)]
    reacted = reaction_BE(source, [F(1, 8), F(1, 10), F(1, 20)], F(7, 3))
    echeck("fraction_BE_catalytic_stoichiometry", sum(reacted) == sum(source) and min(reacted) >= 0,
           amount_residual=str(sum(reacted) - sum(source)),
           scheme="Lie composition of backward Euler substeps, first order")
    v1, v2, d = drag_scalar_fraction(F(4, 3), F(-2, 5), F(2), F(5), F(3, 7), F(11, 4))
    p_residual = 2 * v1 + 5 * v2 - (2 * F(4, 3) + 5 * F(-2, 5))
    k_residual = (2 * v1 ** 2 + 5 * v2 ** 2) / 2 + d - (2 * F(4, 3) ** 2 + 5 * F(-2, 5) ** 2) / 2
    echeck("fraction_quadratic_drag_momentum_and_heat", p_residual == k_residual == 0 and d >= 0,
           momentum_residual=str(p_residual), energy_residual=str(k_residual))

    # Exact rational integrated update with round-trip replay, source ledger and stage audit.
    s = rational_initial()
    initial_energy, initial_amount = rational_total(s), rational_amount(s)
    stages = []
    roundtrips = []
    minimum_heat, minimum_species, minimum_radius = F(10**9), F(10**9), F(10**9)
    for tick in range(2):
        event = {"tag": tick, "xor": [tick % 2, (tick + 1) % 2, 0],
                 "force": F((-1) ** tick, 5), "beam_power": F(7, 3)}
        old_json = rational_json(s)
        replay_state = decode_rational(json.loads(old_json))
        actual, trace = rational_step(s, event, F(2, 5))
        replay, replay_trace = rational_step(replay_state, event, F(2, 5))
        roundtrips.append(rational_json(actual) == rational_json(replay) and trace == replay_trace)
        s = actual
        stages.extend(trace)
        minimum_heat = min(minimum_heat, *s["heat"])
        minimum_species = min(minimum_species, *(v for row in s["chemistry"] for v in row))
        minimum_radius = min(minimum_radius, *s["radii"])
    ledger = s["ledger"]
    energy_residual = rational_total(s) - initial_energy - ledger["work"] - ledger["beam_in"] + ledger["beam_out"]
    amount_residual = rational_amount(s) - initial_amount
    stage_ok = all([row["stage"] for row in stages[i:i + len(RATIONAL_ORDER)]] == RATIONAL_ORDER
                   for i in range(0, len(stages), len(RATIONAL_ORDER)))
    stage_residuals = [row["energy_balance_residual"] for row in stages]
    echeck("rational_end_to_end_stage_order", stage_ok, order=RATIONAL_ORDER, steps=2)
    echeck("rational_end_to_end_exact_energy_source_ledger", energy_residual == 0 and all(v == 0 for v in stage_residuals),
           final_residual=str(energy_residual), audited_stages=len(stages))
    echeck("rational_end_to_end_monomer_and_positivity", amount_residual == 0 and minimum_heat > 0
           and minimum_species >= 0 and minimum_radius > 0,
           amount_residual=str(amount_residual), minimum_heat=float(minimum_heat),
           minimum_species=float(minimum_species), minimum_radius=float(minimum_radius))
    echeck("rational_snapshot_round_trip_and_deterministic_replay", all(roundtrips),
           round_trips=len(roundtrips), serialized_bytes=len(rational_json(s).encode("utf-8")),
           representation="reduced rational numerator/positive denominator, canonical hexadecimal integer strings")

    # A regression must show the failure, rather than accidentally endorse Euler energy conservation.
    fe_h = F(1, 5)
    fe_x = [F(1), F(0)]
    fe_new = [fe_x[0] + fe_h * fe_x[1], fe_x[1] - fe_h * fe_x[0]]
    fe_ratio = fdot(fe_new, fe_new) / fdot(fe_x, fe_x)
    echeck("forward_Euler_nonconservation_regression", fe_ratio == 1 + fe_h * fe_h and fe_ratio > 1,
           measured_energy_factor=str(fe_ratio), correct_energy_factor=str(1 + fe_h * fe_h),
           interpretation="forward Euler adds spurious oscillator energy")

    # First-order BE consistency is checked against the actual differential generator.
    h1, h2 = F(1, 100), F(1, 200)
    exact_generator = -F(5, 7) * (n[0] / c[0] - n[1] / c[1])
    e1 = abs((pair_diffusion_BE(n, c, 0, 1, F(5, 7), h1)[0] - n[0]) / h1 - exact_generator)
    e2 = abs((pair_diffusion_BE(n, c, 0, 1, F(5, 7), h2)[0] - n[0]) / h2 - exact_generator)
    echeck("BE_pair_first_order_generator_consistency", e2 < e1 and F(19, 10) < e1 / e2 < F(21, 10),
           derivative_error_ratio=float(e1 / e2), interpretation="first-order consistency, not exact exponential evolution")

    rates0 = [F(1, 8), F(1, 10), F(1, 20)]
    f0, a0, b0, m0 = source
    rates_at_source = [rates0[0] * f0 * b0, rates0[1] * f0 * a0, rates0[2] * f0 * a0 * b0]
    generator0 = [-sum(rates_at_source), *rates_at_source]
    reaction_errors = []
    for small_h in (h1, h2):
        actual0 = reaction_BE(source, rates0, small_h)
        reaction_errors.append(sum(abs((u - v) / small_h - derivative)
                                   for u, v, derivative in zip(actual0, source, generator0)))
    reaction_ratio = reaction_errors[0] / reaction_errors[1]
    echeck("BE_reaction_first_order_generator_consistency", reaction_errors[1] < reaction_errors[0]
           and F(19, 10) < reaction_ratio < F(21, 10),
           derivative_error_ratio=float(reaction_ratio), generator=[str(v) for v in generator0])

    packet0 = F(7)
    out0, deposits0 = attenuation_BE(packet0, [F(1, 5), F(4, 5), F(13, 10)],
                                    [F(2, 5), F(3, 10), F(7, 10)])
    echeck("fraction_BE_attenuation_packet_balance", out0 + sum(deposits0) == packet0
           and out0 > 0 and min(deposits0) >= 0,
           energy_residual=str(out0 + sum(deposits0) - packet0),
           scheme="first-order spatial backward Euler attenuation, not Beer-Lambert exponential")
    attenuation_errors = []
    for short_length in (h1, h2):
        out1, _ = attenuation_BE(packet0, [F(4, 5)], [short_length])
        attenuation_errors.append(abs((out1 - packet0) / short_length + F(4, 5) * packet0))
    attenuation_ratio = attenuation_errors[0] / attenuation_errors[1]
    echeck("BE_attenuation_first_order_generator_consistency", attenuation_errors[1] < attenuation_errors[0]
           and F(19, 10) < attenuation_ratio < F(21, 10),
           derivative_error_ratio=float(attenuation_ratio), interpretation="spatial consistency for dE/ds=-kappa E")

    rng = np.random.default_rng(20261013)
    midpoint_residuals = []
    for _ in range(120):
        c0 = rng.normal(size=(5, 5))
        q0 = c0.T @ c0 + np.eye(5)
        a0 = rng.normal(size=(5, 5)); j0 = a0 - a0.T
        d0 = rng.normal(size=(3, 5)); r0 = d0.T @ d0
        x0 = rng.normal(size=5); f0 = rng.normal(size=5)
        h0 = float(10 ** rng.uniform(-3, 1))
        xn, dn, wn = midpoint_float(x0, q0, j0, r0, h0, f0)
        midpoint_residuals.append(abs(float(xn @ q0 @ xn / 2 - x0 @ q0 @ x0 / 2 + dn - wn)))
    fcheck("float_midpoint_power_balance", max(midpoint_residuals) < 2e-11,
           samples=120, max_absolute_residual=max(midpoint_residuals), tolerance=2e-11)

    v10 = np.array([1.2, -0.4, 0.7]); v20 = np.array([-0.2, 0.1, 0.3])
    v1n, v2n, dn = drag_vector_float(v10, v20, 2., 5., 0.3, 0.7)
    momentum_r = float(np.max(np.abs(2 * v1n + 5 * v2n - 2 * v10 - 5 * v20)))
    energy_r = abs(float((2 * v1n @ v1n + 5 * v2n @ v2n - 2 * v10 @ v10 - 5 * v20 @ v20) / 2 + dn))
    fcheck("float_vector_drag_momentum_and_heat", momentum_r < 2e-15 and energy_r < 2e-15 and dn >= 0,
           momentum_residual=momentum_r, energy_residual=energy_r, heat=dn)

    packet = 7.
    outgoing, absorbed = optical_exponential(packet, [0.2, 0.8, 1.3], [0.4, 0.3, 0.7])
    optical_r = abs(outgoing + float(np.sum(absorbed)) - packet)
    fcheck("float_optical_packet_energy", optical_r < 2e-15 and np.all(absorbed >= 0),
           energy_residual=optical_r, outgoing=outgoing, absorbed=float(np.sum(absorbed)))

    pair0 = np.array([7., 1.]); cap0 = np.array([2., 3.])
    pairn = pair_diffusion_exponential(pair0, cap0, 0, 1, 5 / 7, 13 / 4)
    pair_r = abs(float(np.sum(pairn) - np.sum(pair0)))
    entropy_delta = float(np.sum(cap0 * np.log(pairn / cap0)) - np.sum(cap0 * np.log(pair0 / cap0)))
    fcheck("float_exact_pair_flow_energy_entropy", pair_r < 2e-15 and np.min(pairn) > 0 and entropy_delta >= 0,
           energy_residual=pair_r, entropy_increase=entropy_delta)

    source0 = np.array([3., .5, .25, 1 / 3])
    rn = reaction_exponential(source0, [.125, .1, .05], 7 / 3)
    reaction_r = abs(float(np.sum(rn) - np.sum(source0)))
    fcheck("float_exponential_reaction_stoichiometry", reaction_r < 2e-15 and np.min(rn) >= 0,
           amount_residual=reaction_r, composition="exact elementary flows, Lie first order for combined kinetics")

    # Nonlinear Euler profile, with the advertised direct CFL schedule and periodic flux cancellation.
    sf = float_initial()
    uf = sf["fluid"].copy()
    h0 = euler_cfl_step(uf, sf["dx"], sf["gamma"])
    un, weight = rusanov_periodic(uf, sf["dx"], h0, sf["gamma"])
    conserved_r = float(np.max(np.abs(sf["dx"] * (np.sum(un, axis=0) - np.sum(uf, axis=0)))))
    fcheck("periodic_Rusanov_nonlinear_Euler", conserved_r < 2e-15 and np.min(un[:, 0]) > 0
           and np.min(internal_energy_density(un)) > 0 and weight <= 1,
           max_conserved_residual=conserved_r, max_convex_weight=weight,
           minimum_density=float(np.min(un[:, 0])), minimum_internal_energy=float(np.min(internal_energy_density(un))),
           h=h0, scheme="conservative Rusanov, first order; direct sigma=0.65 CFL time schedule")
    uv, vd = viscous_midpoint_heat(un, sf["dx"], h0)
    visc_energy_r = abs(float(sf["dx"] * np.sum(uv[:, 2] - un[:, 2])))
    oldint, newint = internal_energy_density(un), internal_energy_density(uv)
    fcheck("compatible_viscous_momentum_heat", visc_energy_r < 2e-15 and abs(vd["momentum_residual"]) < 2e-15
           and vd["minimum_heat_deposit"] >= 0 and np.all(newint >= oldint - 1e-14),
           total_energy_residual=visc_energy_r, **vd)

    # Actual complete float profile, including source work, optical input/output and all stage balances.
    sf = float_initial()
    initial_energy, initial_amount = float_total(sf), float_amount(sf)
    initial_fluid_mass = float(sf["dx"] * np.sum(sf["fluid"][:, 0]))
    initial_fluid_momentum = float(sf["dx"] * np.sum(sf["fluid"][:, 1]))
    trace_residuals = []
    orders_ok = True
    min_density = min_internal = min_heat = min_species = min_radius = math.inf
    max_cfl = max_visc_residual = 0.
    replay_ok = True
    for tick in range(64):
        event = {"tag": tick, "xor": [tick % 2, (tick + 1) % 2, 0],
                 "force": (-1) ** tick / 5, "beam_power": 7 / 3}
        snapshot = json.dumps(hex_encode(sf), sort_keys=True, separators=(",", ":"))
        replay_input = hex_decode(json.loads(snapshot))
        actual, tr, diag = float_step(sf, event)
        replay, replay_trace, replay_diag = float_step(replay_input, event)
        replay_ok = replay_ok and hex_encode(actual) == hex_encode(replay) and tr == replay_trace and diag == replay_diag
        sf = actual
        orders_ok = orders_ok and [row["stage"] for row in tr] == FLOAT_ORDER
        trace_residuals.extend(abs(row["energy_balance_residual"]) for row in tr)
        min_density = min(min_density, float(np.min(sf["fluid"][:, 0])))
        min_internal = min(min_internal, float(np.min(internal_energy_density(sf["fluid"]))))
        min_heat = min(min_heat, float(np.min(sf["body_heat"])))
        min_species = min(min_species, float(np.min(sf["chemistry"])))
        min_radius = min(min_radius, float(np.min(sf["radii"])))
        max_cfl = max(max_cfl, diag["max_convex_weight"])
        max_visc_residual = max(max_visc_residual, abs(diag["kinetic_plus_heat_residual"]))
    ledger = sf["ledger"]
    integrated_energy_r = abs(float_total(sf) - initial_energy - ledger["work"] - ledger["beam_in"] + ledger["beam_out"])
    integrated_amount_r = abs(float_amount(sf) - initial_amount)
    mass_r = abs(float(sf["dx"] * np.sum(sf["fluid"][:, 0])) - initial_fluid_mass)
    momentum_r = abs(float(sf["dx"] * np.sum(sf["fluid"][:, 1])) - initial_fluid_momentum)
    fcheck("float_end_to_end_actual_order", orders_ok, steps=64, order=FLOAT_ORDER)
    fcheck("float_end_to_end_energy_source_ledger", integrated_energy_r < 2e-11 and max(trace_residuals) < 2e-11,
           final_absolute_residual=integrated_energy_r, max_stage_absolute_residual=max(trace_residuals),
           audited_stages=len(trace_residuals), tolerance=2e-11,
           source_work=ledger["work"], beam_in=ledger["beam_in"], beam_out=ledger["beam_out"])
    fcheck("float_end_to_end_conservation_and_positive_states", max(integrated_amount_r, mass_r, momentum_r) < 2e-12
           and min(min_density, min_internal, min_heat, min_radius) > 0 and min_species >= 0 and max_cfl <= 1,
           monomer_residual=integrated_amount_r, gas_mass_residual=mass_r, gas_momentum_residual=momentum_r,
           minimum_density=min_density, minimum_internal_energy_density=min_internal,
           minimum_body_heat=min_heat, minimum_species=min_species, minimum_derived_radius=min_radius,
           max_convex_weight=max_cfl, max_viscous_power_residual=max_visc_residual,
           final_physical_time=sf["time"])
    fcheck("IEEE64_hex_round_trip_and_replay", replay_ok, round_trips=64,
           representation="canonical float.hex / float.fromhex; array shape retained by nesting",
           scope="same runtime and arithmetic evaluation order; no cross-platform libm bitwise claim")

    # Explicit distinction between rational consistency map and the exponential flow.
    exact_pair_float = pair_diffusion_exponential(np.array([float(v) for v in n]), np.array([float(v) for v in c]),
                                                 0, 1, 5 / 7, 13 / 4)
    be_pair_float = np.array([float(v) for v in nd])
    be_flow_difference = float(np.max(np.abs(exact_pair_float - be_pair_float)))
    fcheck("BE_is_not_mislabeled_exact_exponential", be_flow_difference > 0.01,
           max_pair_difference=be_flow_difference,
           interpretation="two distinct specified schemes, each with its own proven balance")

    return {
        "edition": "XD-TAU v1.4 finite reference and verification",
        "seed": 20261013,
        "runtime": {"python": platform.python_version(), "numpy": np.__version__},
        "summary": {"all_passed": all(c["passed"] for c in exact + floating),
                    "exact_rational_checks": len(exact), "floating_checks": len(floating),
                    "rational_integrated_steps": 2, "float_integrated_steps": 64,
                    "rational_integrated_energy_residual": str(energy_residual),
                    "float_integrated_energy_residual": integrated_energy_r,
                    "float_max_stage_energy_residual": max(trace_residuals)},
        "exact_rational": exact,
        "IEEE_float64": floating,
        "mathematical_scope": [
            "Finite, explicitly instantiated split state-transition profiles; full printed stage ordering is exercised.",
            "Fraction arithmetic proves the listed discrete examples exactly; general conservation/invertibility proofs are algebraic in the document.",
            "Rational BE pair/reaction/attenuation maps are first-order consistency schemes, not exact ODE or optical flows.",
            "Exponential pair/reaction/attenuation formulas are exact individual real-arithmetic subflows; the coupled Lie composition is first order.",
            "Rusanov Euler uses a direct CFL time schedule; positivity applies on its ideal-gas admissible state domain.",
            "Floating conservation is measured by residuals; no claim of bitwise exact physical conservation is made.",
            "Finite snapshots losslessly serialize rational state or an already rounded float64 state, not arbitrary mathematical real numbers.",
            "Derived geometry outputs carry no extra stored mechanical energy; the oscillator's storage coefficients remain fixed.",
            "These tests do not establish continuum convergence, arbitrary-material well-posedness, 3-D Navier-Stokes global regularity, or Einstein-field existence.",
        ],
    }


if __name__ == "__main__":
    results = run_verification()
    OUT.write_text(json.dumps(results, indent=2, ensure_ascii=False), encoding="utf-8")
    print(json.dumps(results["summary"], indent=2))
    print(f"Results: {OUT}")

endstream
